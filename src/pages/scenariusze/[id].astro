---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import NextBand from "../../components/NextBand.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { etykiety, podstrony, crumb } from "../../lib/copy.js";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

const page = podstrony.scenariusze;

export async function getStaticPaths() {
  const entries = await getCollection("scenariusze");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const inne = sortByOrder(await getCollection("scenariusze")).filter((item) => item.id !== entry.id);
const crumbs = [
  { href: "/scenariusze/", label: crumb("/scenariusze/") }, { label: entry.data.title }, ];
const typ = entry.data.typ_budzetu || "firmowy";
const osoby = entry.data.goscie || "";
const budzetHref = `/ceny/?typ=${typ}${osoby ? `&osoby=${osoby}` : ""}#estymator`;
const kontaktHref = `/kontakt/?typ=${typ}${osoby ? `&osoby=${osoby}` : ""}`;
const gdzie = entry.data.przestrzen;
const spaceLinks = page.przestrzenie_nazwy
  .filter((item) => new RegExp(item.wzor, "i").test(gdzie))
  .map((item) => ({ href: item.href, label: item.etykieta }));
const kategoria = entry.data.kategorie?.[0];
---

<Base
  title={entry.data.seo_title || `${entry.data.title} | MIEJSCE`}
  description={entry.data.seo_description || entry.data.opis_seo}
  image={entry.data.cover}
  jsonLd={[crumbsJsonLd([{ href: "/", label: crumb("/") }, { href: "/scenariusze/", label: crumb("/scenariusze/") }, { href: `/scenariusze/${entry.id}/`, label: entry.data.title }])]}
>
  <PageHero
    crumbs={crumbs}
    kicker={entry.data.tag}
    title={entry.data.h1 || entry.data.title}
    lede={entry.data.lead}
    image={entry.data.cover}
    imageAlt={entry.data.title}
  />

  <section class="band" aria-labelledby="przebieg">
    <div class="wrap split">
      <div class="stack">
        <p class="meta">{osoby ? `${osoby} ${page.osob}` : entry.data.tag}</p>
        <div class="prose"><Content /></div>
        <SectionHeader eyebrow={page.dzien} title={page.przebieg} />
        <ol class="timeline" id="przebieg">
          {
            entry.data.program.map((punkt) => (
              <li>
                <span class="when">{punkt.godzina}</span>
                <div>
                  <h3>{punkt.tytul}</h3>
                  <p>{punkt.opis}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <aside class="card stack pad">
        <p class="eyebrow">{page.polacz}</p>
        <h3>{entry.data.przestrzen}</h3>
        <ul class="included">
          {entry.data.zakres.map((item) => <li>{item}</li>)}
        </ul>
        <p class="fine">{page.zastrzezenie}</p>
        <div class="text-links">
          {spaceLinks.map((link) => <a class="text-link" href={link.href}>{link.label}</a>)}
          {kategoria && <a class="text-link" href={`/eventy/${kategoria}/`}>{page.wroc}</a>}
          <a class="text-link" href={kontaktHref}>{page.plan}</a>
        </div>
        <a class="btn btn-primary" href={budzetHref}>{page.dopasuj}</a>
      </aside>
    </div>
  </section>

  <section class="band band-dark" aria-labelledby="galeria-scen">
    <div class="wrap stack-lg">
      <SectionHeader eyebrow={page.brew_galeria} title={page.tak} lead={page.zdjecia} />
      <div class="gallery-row" id="galeria-scen">
        {entry.data.zdjecia.slice(0, 3).map((src) => <img src={src} alt="" />)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <SectionHeader eyebrow={page.inne} title={page.tez} />
      <div class="cards-3">
        {
          inne.slice(0, 3).map((event) => (
            <article class="media-card">
              <a href={`/scenariusze/${event.id}/`}>
                <img src={event.data.cover} alt="" />
                <div class="card-body">
                  <p class="eyebrow">{event.data.tag}</p>
                  <h3>{event.data.title}</h3>
                  <span class="btn btn-ghost">{page.zobacz}</span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <NextBand
    title={page.policz}
    links={[
      { href: budzetHref, label: page.sprawdz }, { href: "/przestrzenie/", label: page.link_przestrzenie }, { href: "/jedzenie-i-bar/", label: etykiety.jedzenie_i_bar }, ]}
    cta={page.cta}
    href={kontaktHref}
  />
</Base>
