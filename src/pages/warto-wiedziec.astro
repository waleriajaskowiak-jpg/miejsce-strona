---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import NextBand from "../components/NextBand.astro";
import { podstrony, crumb } from "../lib/copy.js";
import { crumbsJsonLd, sortByOrder } from "../lib/nav.js";

const page = podstrony.warto;

const entries = sortByOrder(await getCollection("faq"));
const faq = [];
for (const entry of entries) {
  const { Content } = await render(entry);
  faq.push({ entry, Content });
}
const groups = [...faq.reduce((map, row) => {
  const key = row.entry.data.temat || page.temat_domyslny;
  map.set(key, [...(map.get(key) || []), row]);
  return map;
}, new Map())];
const slug = (label) => label.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const crumbs = [{ href: "/warto-wiedziec/", label: crumb("/warto-wiedziec/") }];
const faqLd = {
  "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map(({ entry }) => ({
    "@type": "Question", name: entry.data.pytanie, acceptedAnswer: {
      "@type": "Answer", text: (entry.body || "").replace(/\s+/g, " ").trim(), }, })), };
---

<Base
  title={page.tytul}
  description={page.opis}
  image={page.zdjecie}
  jsonLd={[crumbsJsonLd([{ href: "/", label: crumb("/") }, ...crumbs]), faqLd]}
>
  <PageHero
    crumbs={crumbs}
    kicker={page.brew}
    title={page.h}
    lede={page.lead}
    image={page.zdjecie}
    imageAlt={page.alt}
  />
  <section class="band tight-top">
    <div class="wrap faq-layout">
      <nav class="faq-nav" aria-label="Tematy">
        {groups.map(([temat]) => <a class="pill" href={`#${slug(temat)}`}>{temat}</a>)}
      </nav>
      <div>
        {groups.map(([temat, rows]) => (
          <div class="faq-group" id={slug(temat)}>
            <h2>{temat}</h2>
            {rows.map(({ entry, Content }) => (
              <details class="acc">
                <summary>{entry.data.pytanie}</summary>
                <div class="acc-body"><Content /></div>
              </details>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>
  <NextBand
    title={page.nastepny}
    links={[
      { href: "/ceny/#estymator", label: page.link_budzet }, { href: "/przestrzenie/", label: page.link_przestrzenie }, { href: "/kontakt/", label: page.cta }, ]}
  />
</Base>
