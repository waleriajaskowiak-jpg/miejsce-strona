---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import NextBand from "../components/NextBand.astro";
import { crumbsJsonLd, sortByOrder } from "../lib/nav.js";

const entries = sortByOrder(await getCollection("faq"));
const faq = [];
for (const entry of entries) {
  const { Content } = await render(entry);
  faq.push({ entry, Content });
}
const groups = [...faq.reduce((map, row) => {
  const key = row.entry.data.temat || "Przed eventem";
  map.set(key, [...(map.get(key) || []), row]);
  return map;
}, new Map())];
const slug = (label) => label.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const crumbs = [{ href: "/warto-wiedziec/", label: "Warto wiedzieć" }];
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ entry }) => ({
    "@type": "Question",
    name: entry.data.pytanie,
    acceptedAnswer: {
      "@type": "Answer",
      text: (entry.body || "").replace(/\s+/g, " ").trim(),
    },
  })),
};
---

<Base
  title="Warto wiedzieć przed eventem | MIEJSCE"
  description="Deszcz, zima, godziny, parking, dojazd, dostępność, DJ, AV, branding, menu, diety, open bar i oględziny"
  image="/img/gallery/dm22.jpg"
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, ...crumbs]), faqLd]}
>
  <PageHero
    crumbs={crumbs}
    kicker="Zanim wyślesz brief"
    title="Warto wiedzieć przed eventem"
    lede="Krótkie odpowiedzi. Tam, gdzie nie mamy liczby w ofercie, mówimy wprost, że potwierdzimy ją pod termin"
    image="/img/gallery/dm22.jpg"
    imageAlt="Barka MIEJSCA nocą"
  />
  <section class="band tight-top">
    <div class="wrap faq-layout">
      <nav class="faq-nav" aria-label="Tematy">
        {groups.map(([temat]) => <a class="pill" href={`#${slug(temat)}`}>{temat}</a>)}
      </nav>
      <div>
        {groups.map(([temat, rows]) => (
          <div class="faq-group" id={slug(temat)}>
            <h2>{temat}</h2>
            {rows.map(({ entry, Content }) => (
              <details class="acc">
                <summary>{entry.data.pytanie}</summary>
                <div class="acc-body"><Content /></div>
              </details>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>
  <NextBand
    title="Zostało pytanie?"
    links={[
      { href: "/ceny/#estymator", label: "Sprawdź budżet" },
      { href: "/przestrzenie/", label: "Zobacz przestrzenie" },
      { href: "/kontakt/", label: "Zaplanuj event" },
    ]}
  />
</Base>
