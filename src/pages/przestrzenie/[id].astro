---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import NextBand from "../../components/NextBand.astro";
import { crumbsJsonLd, sortByOrder, zloty } from "../../lib/nav.js";

export async function getStaticPaths() {
  const entries = await getCollection("przestrzenie");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const specIcon = (text) => {
  const t = text.toLowerCase();
  if (t.includes("osób") || t.includes("osob") || t.includes("gości")) return "users";
  if (t.includes("taras")) return "terrace";
  if (t.includes("m²") || t.includes("m2")) return "ruler";
  return "check";
};
const specRank = (name) => (name === "users" ? 0 : name === "ruler" || name === "terrace" ? 1 : 2);
const specChips = (text) =>
  String(text || "")
    .split("·")
    .map((part) => part.trim())
    .filter(Boolean)
    .map((label) => ({ label, name: specIcon(label) }));
const { entry } = Astro.props;
const { Content } = await render(entry);
const wszystkie = sortByOrder(await getCollection("przestrzenie"));
const inne = wszystkie.filter((item) => item.id !== entry.id);
const crumbs = [
  { href: "/przestrzenie/", label: "Przestrzenie" },
  { label: entry.data.title },
];
---

<Base
  title={`${entry.data.title} | MIEJSCE`}
  description={entry.data.opis_seo}
  image={entry.data.cover}
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, { href: "/przestrzenie/", label: "Przestrzenie" }, { href: `/przestrzenie/${entry.id}/`, label: entry.data.title }])]}
>
  <PageHero
    crumbs={crumbs}
    kicker="Przestrzeń"
    title={entry.data.title}
    lede={entry.data.lead}
    image={entry.data.cover}
    imageAlt={entry.data.title}
  >
    {entry.data.meta && <p class="meta">{entry.data.meta}</p>}
  </PageHero>

  <section class="band">
    <div class="wrap">
      <nav class="sibling-nav" aria-label="Inne przestrzenie">
        {wszystkie.map((space) => (
          <a class:list={["btn", space.id === entry.id ? "btn-primary" : "btn-ghost"]} href={`/przestrzenie/${space.id}/`} aria-current={space.id === entry.id ? "page" : undefined}>{space.data.title}</a>
        ))}
      </nav>
    </div>
    <div class="wrap split">
      <div class="prose">
        <Content />
        {
          entry.data.cena_od ? (
            <p>
              Wynajem {entry.data.cena_etykieta || `od ${zloty(entry.data.cena_od)}`} za 5 h, netto. Do ceny doliczamy 10% serwisu.{" "}
              <a href="/ceny/">Zobacz ceny</a>
            </p>
          ) : entry.data.cena_etykieta ? (
            <p>
              Wynajem: {entry.data.cena_etykieta}. Do cen jedzenia i baru doliczamy 10% serwisu.{" "}
              <a href={`/kontakt/?przestrzen=${encodeURIComponent(entry.data.title)}`}>Poproś o wycenę</a>
            </p>
          ) : null
        }
        <div class="btn-row">
          <a class="btn" href={`/kontakt/?przestrzen=${encodeURIComponent(entry.data.title)}`}>
            Zapytaj o {entry.data.title}
          </a>
          <a class="btn btn-ghost" href="/ceny/">Ceny i możliwości</a>
        </div>
      </div>
      <div>
        <p class="kicker">Najlepiej sprawdza się na</p>
        <ul class="tags">
          {entry.data.najlepiej.map((item) => <li>{item}</li>)}
        </ul>
        <p class="eyebrow">W skrócie</p>
        <ul class="spec-chips">
          {[...entry.data.w_skrocie]
            .sort((a, b) => specRank(specIcon(a)) - specRank(specIcon(b)))
            .map((item) => (
              <li><Icon name={specIcon(item)} /><span>{item}</span></li>
            ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap mosaic">
      {
        entry.data.zdjecia.slice(0, 3).map((src, index) => (
          <figure class:list={["print", index === 0 ? "big tilt-l land" : index === 1 ? "tilt-r" : "tilt-s"]}>
            <img src={src} alt={`${entry.data.title}, zdjęcie ${index + 1}`} loading="lazy" />
          </figure>
        ))
      }
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Pozostałe przestrzenie</h2>
      <div class="more-spaces">
        {
          inne.map((space, index) => (
            <a class="more-card" href={`/przestrzenie/${space.id}/`}>
              <img src={space.data.cover} alt="" loading="lazy" />
              <span class="more-body">
                <span class="num">0{index + 1}</span>
                <h3>{space.data.title}</h3>
                <ul class="spec-chips">
                  {specChips(space.data.meta).map((chip) => (
                    <li><Icon name={chip.name} /><span>{chip.label}</span></li>
                  ))}
                </ul>
                <span class="go">Zobacz <Icon name="arrow" /></span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <NextBand
    kicker="Następny krok"
    title="Sprawdź, czy budżet się mieści"
    links={[
      { href: "/ceny/#estymator", label: "Sprawdź budżet" },
      { href: "/eventy/", label: "Scenariusze" },
      { href: "/jedzenie-i-bar/", label: "Jedzenie i bar" },
    ]}
    cta={`Zapytaj o ${entry.data.title}`}
    href={`/kontakt/?wiadomosc=${encodeURIComponent("Chcę zapytać o " + entry.data.title)}#brief`}
  />
</Base>
