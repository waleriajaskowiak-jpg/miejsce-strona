---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import NextBand from "../../components/NextBand.astro";
import SpacePicker from "../../components/SpacePicker.astro";
import { etykiety, podstrony, crumb } from "../../lib/copy.js";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

const page = podstrony.przestrzenie;

const przestrzenie = sortByOrder(await getCollection("przestrzenie"));
const fakty = (await getEntry("ustawienia", "fakty"))!.data;
const crumbs = [{ href: "/przestrzenie/", label: crumb("/przestrzenie/") }];
const description = page.opis;
---

<Base
  title={page.tytul}
  description={description}
  jsonLd={[crumbsJsonLd([{ href: "/", label: crumb("/") }, ...crumbs])]}
>
  <section class="band band-ink editorial">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <SpacePicker fakty={fakty} spaces={przestrzenie} heading="h1" />
    </div>
  </section>
  {
    przestrzenie.map((space, index) => (
      <section class:list={["band", "space-band", index % 2 ? "band-sand" : "band-ink"]}>
        <div class="wrap space-detail">
          <div>
            <p class="eyebrow">0{index + 1}</p>
            <h2>{space.data.title}</h2>
            <p class="lead">{space.data.lead}</p>
            <ul class="pills">
              {space.data.najlepiej.slice(0, 4).map((item) => <li>{item}</li>)}
            </ul>
            <ul class="spec-list">
              {space.data.w_skrocie.slice(0, 6).map((item) => <li>{item}</li>)}
            </ul>
            <p class="btn-row"><a class="btn btn-primary" href={`/przestrzenie/${space.id}/`}>{page.zobacz} {space.data.title}</a></p>
          </div>
          <div class="space-shots">
            {space.data.zdjecia.slice(0, 3).map((src) => <img src={src} alt="" width="1800" height="1200" />)}
          </div>
        </div>
      </section>
    ))
  }
  <NextBand
    kicker={etykiety.nastepny_krok}
    title={page.nastepny}
    links={[
      { href: "/eventy/", label: page.eventy }, { href: "/ceny/", label: page.ceny }, { href: "/kontakt/", label: page.ogledziny }, ]}
    cta={page.cta}
  />
</Base>
