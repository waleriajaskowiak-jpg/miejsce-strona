---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import NextBand from "../../components/NextBand.astro";
import SpacePicker from "../../components/SpacePicker.astro";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

const przestrzenie = sortByOrder(await getCollection("przestrzenie"));
const fakty = (await getEntry("ustawienia", "fakty"))!.data;
const crumbs = [{ href: "/przestrzenie/", label: "Przestrzenie" }];
const description = "Dwie barki, zadaszone tarasy i ogród w Porcie Czerniakowskim. Cztery układy: Duże Miejsce, Małe Miejsce, ogród i cały kompleks.";
---

<Base
  title="Przestrzenie — dwie barki, tarasy i ogród | MIEJSCE"
  description={description}
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, ...crumbs])]}
>
  <section class="band band-ink editorial">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <SpacePicker fakty={fakty} spaces={przestrzenie} heading="h1" />
    </div>
  </section>
  <NextBand
    kicker="Następny krok"
    title="Wybierz scenariusz albo policz budżet"
    links={[
      { href: "/eventy/", label: "Scenariusze eventów" },
      { href: "/ceny/", label: "Ceny" },
      { href: "/kontakt/", label: "Umów oględziny" },
    ]}
    cta="Zapytaj o termin"
  />
</Base>
