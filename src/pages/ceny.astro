---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Budzet from "../components/Budzet.astro";
import NextBand from "../components/NextBand.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { crumbsJsonLd, sortByOrder, zloty } from "../lib/nav.js";

const cennik = (await getEntry("ustawienia", "cennik"))!.data;
const faqEntries = sortByOrder(await getCollection("faq")).slice(0, 8);
const faq = [];
for (const entry of faqEntries) {
  const { Content } = await render(entry);
  faq.push({ entry, Content });
}
const crumbs = [{ href: "/ceny/", label: "Ceny" }];
const cardPhoto = { nowe: "/img/gallery/mm12.jpg", duze: "/img/gallery/dm22.jpg", cale: "/img/gallery/og05.jpg" };
const addonIcons = {
  "Obsługa": `<circle cx="6" cy="4.6" r="1.7"/><path d="M3.8 10.2c.6-1.4 1.5-2 2.2-2s1.6.6 2.2 2"/><path d="M4.6 10.4v8.2M7.4 10.4v8.2"/><path d="M9.2 8.8h12"/><path d="M11 8.8V7.2a3 3 0 0 1 6 0v1.6"/>`,
  "AV": `<rect x="1.4" y="3.6" width="9.4" height="6.4" rx="1.2"/><path d="M3.4 12.4h5.4"/><rect x="14.2" y="6.2" width="4.2" height="7.2" rx="2.1"/><path d="M13.2 12.6a3.1 3.1 0 0 0 6.2 0"/><path d="M16.3 15.8V19"/><path d="M14.2 19h4.2"/>`,
  "DJ i muzyka": `<circle cx="10" cy="12" r="7"/><circle cx="10" cy="12" r="4.2"/><circle cx="10" cy="12" r="1.2"/><path d="M16.2 4.8c.8.6 1.4 1.8.8 3.1L13.2 12.4"/><circle cx="17.6" cy="4.4" r="1.15"/>`,
  "Bar mobilny": `<path d="M6.4 2.6h6.2l.7 2H5.7z"/><path d="M5.6 4.6h8l-.8 2.6H6.4z"/><path d="M6.4 7.2 5.2 17.4h8.6l-1.2-10.2"/><path d="M4.6 17.4h10"/><path d="M15.6 8.2h5.2L18.2 13h-2.6z"/><path d="M16.9 13v3.4"/><path d="M15.2 16.4h3.4"/>`,
};
const foodPhoto = ["/img/pdf/menu-1.jpg", "/img/pdf/menu-2.jpg", "/img/pdf/menu-3.jpg"];
const barPhoto = ["/img/pdf/menu-4.jpg", "/img/pdf/menu-5.jpg", "/img/gallery/dm06.jpg"];
const payload = JSON.stringify({
  wynajem: cennik.wynajem,
  catering: cennik.catering,
  bar: cennik.open_bar,
}).replace(/</g, "\\u003c");
---

<Base
  title="Ile kosztuje event w MIEJSCU? | Ceny"
  description={cennik.opis_seo}
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, ...crumbs])]}
>
  <PageHero
    crumbs={crumbs}
    kicker="Oferta 2026 · netto"
    title={cennik.naglowek}
    lede={cennik.lead}
    image="/img/gallery/og16.jpg"
    imageAlt="Taras nad wodą"
  >
    <ul class="price-notes">
      {(cennik.uwagi || []).map((item) => <li>{typeof item === "string" ? item : item.tekst}</li>)}
    </ul>
  </PageHero>

  <section class="band" id="wynajem">
    <div class="wrap">
      <SectionHeader eyebrow="Przestrzeń" title="Wybierz pakiet" lead="Kliknij kartę. Estymator poniżej przeliczy widełki z opublikowanych cen." />
      <div class="price-cards" data-packages>
        {
          cennik.wynajem.map((row) => (
            <button type="button" class:list={["price-card", row.id === "duze" && "is-on"]} data-space={row.id} aria-pressed={row.id === "duze" ? "true" : "false"}>
              <img src={cardPhoto[row.id]} alt="" />
              <span class="card-body">
                <span class="eyebrow">{row.dopisek}</span>
                <h3>{row.nazwa}</h3>
                <span class="price">{row.cena_od ? `od ${zloty(row.cena_od)}` : "wycena indywidualna"}</span>
                <span class="meta">5 h · netto · +10% serwisu</span>
              </span>
            </button>
          ))
        }
      </div>

      <div class="estimator" id="estymator" data-estimator>
        <script type="application/json" id="estimator-data" set:html={payload} />
        <div class="controls">
          <div class="est-head">
            <h3>Estymator</h3>
            <p class="est-count" data-est-count hidden>Krok 1 z 3</p>
          </div>
          <label class="slider-block" data-est-panel>
            <span class="slider-k">Liczba gości</span>
            <span class="slider-val" data-est-guests>80<small>osób</small></span>
            <input type="range" min="10" max="350" step="5" value="80" data-guests />
          </label>
          <div data-est-panel>
            <p class="eyebrow">Catering</p>
            <div class="chips">
              {cennik.catering.map((row, index) => (
                <button type="button" class="choice" data-catering={row.id} aria-pressed={index === 0 ? "true" : "false"}>{row.nazwa}</button>
              ))}
            </div>
          </div>
          <div data-est-panel>
            <p class="eyebrow">Bar</p>
            <div class="chips">
              {cennik.open_bar.map((row, index) => (
                <button type="button" class="choice" data-bar={row.id} aria-pressed={index === 0 ? "true" : "false"}>{row.nazwa}</button>
              ))}
            </div>
          </div>
          <div class="est-nav" data-est-nav hidden>
            <button type="button" class="btn btn-ghost btn-sm" data-est-prev>Wstecz</button>
            <button type="button" class="btn btn-primary btn-sm" data-est-next>Dalej</button>
          </div>
        </div>
        <div class="total">
          <p class="eyebrow">Orientacyjnie</p>
          <p class="total-num" data-total>od 0 zł</p>
          <p data-service>netto, za 5 h wynajmu. +10% serwisu. Bez obsługi kelnerskiej, AV i DJ-a.</p>
          <p data-quote hidden><a class="btn btn-primary" href="/kontakt/?przestrzen=Ca%C5%82e%20Miejsce">Poproś o wycenę</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band-dark">
    <div class="wrap stack-lg">
      <SectionHeader eyebrow="W cenie pakietu" title={cennik.catering_h} lead={cennik.catering_lead} />
      <div class="cards-3">
        {cennik.catering.map((row, index) => (
          <article class="tier-card">
            <img src={foodPhoto[index]} alt="" />
            <div class="card-body">
              <h3>{row.nazwa}</h3>
              <p class="price">{row.cena} <small>{row.jednostka}</small></p>
              <p>{row.opis}</p>
            </div>
          </article>
        ))}
      </div>
      <SectionHeader eyebrow="Open bar" title={cennik.bar_h} lead={cennik.bar_info} />
      <div class="cards-3">
        {cennik.open_bar.map((row, index) => (
          <article class="tier-card">
            <img src={barPhoto[index]} alt="" />
            <div class="card-body">
              <h3>{row.nazwa}</h3>
              <p class="price">{row.cena} <small>{row.jednostka}</small></p>
              <p>{row.opis}</p>
            </div>
          </article>
        ))}
      </div>
      <SectionHeader eyebrow="Dodatki" title={cennik.dodatki_h} lead={cennik.dodatki_lead} />
      <div class="addon-block">
      <div class="addon-row" data-snap>
        {cennik.dodatki.map((row) => (
          <article class="addon">
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={addonIcons[row.nazwa]} />
            <h3>{row.nazwa}</h3>
            <p>{row.opis}</p>
          </article>
        ))}
      </div>
      <div class="snap-dots" data-snapdots aria-hidden="true"></div>
      <div class="addon-foot">
        <a class="btn btn-ghost" href={cennik.pdf}>{cennik.pdf_etykieta}</a>
      </div>
      </div>
    </div>
  </section>

  <section class="band band-ink" id="budzet">
    <div class="wrap">
      <Budzet cennik={cennik} wariant="pelny" />
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <SectionHeader eyebrow="Pytania" title="Zanim wyślesz brief" lead="Krótkie odpowiedzi. Tam, gdzie nie mamy liczby, potwierdzamy ją pod termin." />
      {
        faq.map(({ entry, Content }) => (
          <details class="acc">
            <summary>{entry.data.pytanie}</summary>
            <div class="acc-body"><Content /></div>
          </details>
        ))
      }
    </div>
  </section>

  <NextBand
    kicker="Następny krok"
    title="Ułóż menu albo napisz do nas"
    links={[
      { href: "/jedzenie-i-bar/", label: "Jedzenie i bar" },
      { href: "/eventy/", label: "Scenariusze eventów" },
      { href: "/przestrzenie/", label: "Przestrzenie" },
    ]}
    cta="Wyślij brief"
  />
</Base>

<script>
  const root = document.querySelector("[data-estimator]");
  const data = JSON.parse(document.querySelector("#estimator-data")?.textContent || "{}");
  const money = new Intl.NumberFormat("pl-PL", { useGrouping: true });
  const guests = root?.querySelector("[data-guests]");
  const guestOut = root?.querySelector("[data-est-guests]");
  const totalEl = root?.querySelector("[data-total]");
  let space = "duze";
  let catering = data.catering?.[0]?.id;
  let bar = data.bar?.[0]?.id;
  let shown = 0;

  const priceOf = (list, id) => {
    const row = list?.find((item) => item.id === id);
    const n = row?.cena_od ?? row?.cena;
    return typeof n === "number" ? n : null;
  };
  let frame = 0;

  const paint = () => {
    frame += 1;
    const mine = frame;
    if (guestOut) guestOut.firstChild.textContent = guests.value;
    const rental = priceOf(data.wynajem, space);
    const service = root.querySelector("[data-service]");
    const quote = root.querySelector("[data-quote]");
    if (rental == null) {
      shown = 0;
      totalEl?.classList.add("is-quote");
      if (totalEl) totalEl.textContent = "wycena indywidualna";
      if (service) service.textContent = "Całe Miejsce nie ma ceny „od”. Jedzenie i bar zostają w progach na tej stronie. +10% serwisu. Bez obsługi kelnerskiej, AV i DJ-a.";
      const link = quote?.querySelector("a");
      if (link) link.setAttribute("href", `/kontakt/?przestrzen=${encodeURIComponent("Całe Miejsce")}&osoby=${guests.value}`);
      if (quote) quote.hidden = false;
      return;
    }
    totalEl?.classList.remove("is-quote");
    if (quote) quote.hidden = true;
    if (service) service.textContent = "netto, za 5 h wynajmu. +10% serwisu. Bez obsługi kelnerskiej, AV i DJ-a.";
    const next = rental + Number(guests.value) * ((priceOf(data.catering, catering) || 0) + (priceOf(data.bar, bar) || 0));
    const from = shown;
    const start = performance.now();
    const step = (now) => {
      if (mine !== frame) return;
      const k = Math.min(1, (now - start) / 420);
      shown = Math.round(from + (next - from) * (1 - Math.pow(1 - k, 3)));
      if (totalEl) totalEl.textContent = `od ${money.format(shown)} zł`;
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  document.querySelectorAll("[data-space]").forEach((button) => {
    button.addEventListener("click", () => {
      space = button.getAttribute("data-space");
      document.querySelectorAll("[data-space]").forEach((peer) => {
        const on = peer === button;
        peer.classList.toggle("is-on", on);
        peer.setAttribute("aria-pressed", on ? "true" : "false");
      });
      paint();
    });
  });
  root?.querySelectorAll("[data-catering]").forEach((button) => {
    button.addEventListener("click", () => {
      catering = button.getAttribute("data-catering");
      root.querySelectorAll("[data-catering]").forEach((peer) => peer.setAttribute("aria-pressed", peer === button ? "true" : "false"));
      paint();
    });
  });
  root?.querySelectorAll("[data-bar]").forEach((button) => {
    button.addEventListener("click", () => {
      bar = button.getAttribute("data-bar");
      root.querySelectorAll("[data-bar]").forEach((peer) => peer.setAttribute("aria-pressed", peer === button ? "true" : "false"));
      paint();
    });
  });
  guests?.addEventListener("input", paint);

  const params = new URLSearchParams(location.search);
  const osoby = Number(String(params.get("osoby") || "").replace(/[^\d]/g, ""));
  if (guests && Number.isFinite(osoby) && osoby > 0) guests.value = String(Math.min(350, Math.max(10, osoby)));
  paint();

  const estMq = window.matchMedia("(max-width: 760px)");
  const panels = [...(root?.querySelectorAll("[data-est-panel]") || [])];
  const nav = root?.querySelector("[data-est-nav]");
  const count = root?.querySelector("[data-est-count]");
  let estStep = 0;
  const syncSteps = () => {
    const on = estMq.matches;
    if (nav) nav.hidden = !on;
    if (count) count.hidden = !on;
    panels.forEach((panel, index) => {
      panel.hidden = on ? index !== estStep : false;
    });
    if (count) count.textContent = `Krok ${estStep + 1} z ${panels.length}`;
    const prev = nav?.querySelector("[data-est-prev]");
    const next = nav?.querySelector("[data-est-next]");
    if (prev) prev.hidden = estStep === 0;
    if (next) next.hidden = estStep >= panels.length - 1;
  };
  nav?.querySelector("[data-est-prev]")?.addEventListener("click", () => {
    estStep = Math.max(0, estStep - 1);
    syncSteps();
  });
  nav?.querySelector("[data-est-next]")?.addEventListener("click", () => {
    estStep = Math.min(panels.length - 1, estStep + 1);
    syncSteps();
  });
  syncSteps();
  estMq.addEventListener("change", syncSteps);
</script>
