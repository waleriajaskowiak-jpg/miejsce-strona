---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Budzet from "../components/Budzet.astro";
import NextBand from "../components/NextBand.astro";
import PageHero from "../components/PageHero.astro";
import { crumbsJsonLd, zloty } from "../lib/nav.js";

const cennik = (await getEntry("ustawienia", "cennik"))!.data;
const crumbs = [{ href: "/ceny/", label: "Ceny" }];
const cardPhoto = { nowe: "/img/gallery/mm12.jpg", duze: "/img/gallery/dm22.jpg", cale: "/img/gallery/og05.jpg" };
---

<Base
  title="Ile kosztuje event w MIEJSCU? | Ceny"
  description={cennik.opis_seo}
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, ...crumbs])]}
>
  <PageHero
    crumbs={crumbs}
    kicker="Oferta 2026 · netto"
    title={cennik.naglowek}
    lede={`${cennik.lead} ${cennik.netto_info}`}
    image="/img/gallery/og16.jpg"
    imageAlt="Taras nad wodą"
  />

  <section class="sec sec-tint" id="wynajem">
    <div class="wrap">
      <div class="price-cards">
        {
          cennik.wynajem.map((row, index) => (
            <article class:list={["price-card", "has-photo", index === 1 && "is-hot"]} style={`background-image:url(${cardPhoto[row.id] || "/img/gallery/dm04.jpg"})`}>
              <p class="kicker">{row.dopisek}</p>
              <h2>{row.nazwa}</h2>
              <span class="sum">od {zloty(row.cena_od)}</span>
              <p>netto, orientacyjnie</p>
            </article>
          ))
        }
      </div>
      <div class="calc-line" data-person>
        <label>Ile osób na sam catering <input type="range" min="20" max="200" value="80" step="10" /></label>
        <p data-person-out></p>
      </div>
    </div>
  </section>
  <script>
    const root = document.querySelector("[data-person]");
    const input = root?.querySelector("input");
    const out = root?.querySelector("[data-person-out]");
    const rates = [180, 220, 250];
    const paint = () => {
      const n = Number(input.value);
      const lines = rates.map((rate) => `${n} × ${rate} zł = ${(n * rate).toLocaleString("pl-PL")} zł`);
      out.textContent = `Tylko catering, netto, bez przestrzeni i baru: ${lines.join(" · ")}`;
    };
    input?.addEventListener("input", paint);
    paint();
  </script>

  <section class="sec" id="jedzenie" style="padding-top:0">
    <div class="wrap split">
      <div>
        <h2>{cennik.catering_h}</h2>
        <p class="sec-lead">{cennik.catering_lead}</p>
        <p><a href="/jedzenie-i-bar/">Zobacz pełne menu</a></p>
      </div>
      <ul class="menu-lines">
        {
          cennik.catering.map((row) => (
            <li class="menu-line">
              <span>
                <b>{row.nazwa}</b>
                <small>{row.opis}</small>
              </span>
              <span class="sum">{row.cena} {row.jednostka}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap split">
      <div>
        <h2>{cennik.bar_h}</h2>
        <p class="sec-lead">{cennik.bar_info}</p>
      </div>
      <ul class="menu-lines">
        {
          cennik.open_bar.map((row) => (
            <li class="menu-line">
              <span>
                <b>{row.nazwa}</b>
                <small>{row.opis}</small>
              </span>
              <span class="sum">{row.cena} {row.jednostka}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap split">
      <div>
        <h2>{cennik.dodatki_h}</h2>
        <p class="sec-lead">{cennik.dodatki_lead}</p>
        <p><a href={cennik.pdf}>{cennik.pdf_etykieta}</a></p>
      </div>
      <ul class="menu-lines">
        {
          cennik.dodatki.map((row) => (
            <li class="menu-line">
              <span>
                <b>{row.nazwa}</b>
                <small>{row.opis}</small>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec sec-dark" id="budzet-sekcja" style="padding-top:48px">
    <div class="wrap">
      <Budzet cennik={cennik} wariant="pelny" />
    </div>
  </section>
  <NextBand
    kicker="Następny krok"
    title="Ułóż menu albo napisz do nas"
    links={[
      { href: "/jedzenie-i-bar/", label: "Jedzenie i bar" },
      { href: "/eventy/", label: "Scenariusze eventów" },
      { href: "/przestrzenie/", label: "Przestrzenie" },
    ]}
    cta="Wyślij brief"
  />
</Base>
