---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import FormatSlider from "../../components/FormatSlider.astro";
import NextBand from "../../components/NextBand.astro";
import StatRow from "../../components/StatRow.astro";
import Slider from "../../components/Slider.astro";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

export async function getStaticPaths() {
  const entries = await getCollection("kategorie");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const przestrzenie = sortByOrder(await getCollection("przestrzenie")).filter((item) => entry.data.przestrzenie.includes(item.id));
const scenariusze = sortByOrder(await getCollection("scenariusze")).filter((item) => entry.data.scenariusze.includes(item.id));
const pierwszy = scenariusze[0];
const faqAll = sortByOrder(await getCollection("faq")).slice(0, 4);
const faq = [];
for (const item of faqAll) {
  const rendered = await render(item);
  faq.push({ item, Content: rendered.Content });
}
const sekcje = entry.id === "premiery-i-wydarzenia-specjalne" ? (await getEntry("ustawienia", "sekcje"))?.data : null;
const crumbs = [
  { href: "/eventy/", label: "Wydarzenia" },
  { label: entry.data.nav_label },
];
const typ = pierwszy?.data.typ_budzetu || "firmowy";
const budzetHref = `/ceny/?typ=${typ}${pierwszy?.data.goscie ? `&osoby=${pierwszy.data.goscie}` : ""}#estymator`;
const kontaktHref = `/kontakt/?typ=${entry.id}`;
const feature = przestrzenie[0];
const restSpaces = przestrzenie.slice(1);
---

<Base
  title={entry.data.seo_title}
  description={entry.data.seo_description}
  image={entry.data.cover}
  robots={entry.data.szkic ? "noindex,follow" : "index,follow"}
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, { href: "/eventy/", label: "Wydarzenia" }, { href: `/eventy/${entry.id}/`, label: entry.data.title }])]}
  eventColor={entry.data.kolor}
  eventOn={entry.data.kolor_tekst}
>
  <header class="event-hero">
    <div class="event-hero-band">
      <div class="event-wash" aria-hidden="true"><span></span><span></span></div>
      <div class="wrap event-hero-grid">
        <div class="event-hero-copy">
          <Crumbs items={crumbs} />
          <p class="kicker">{entry.data.nav_label}</p>
          <h1>{entry.data.title}</h1>
          <p class="lede">{entry.data.lead}</p>
        </div>
        <figure class="event-hero-photo">
          <img src={entry.data.cover} alt={entry.data.title} width="1600" height="1100" />
        </figure>
      </div>
    </div>
  </header>
  <section class="event-sheet" aria-label="W skrócie">
    <div class="wrap">
      <nav class="pills" aria-label="Zakres">
        {entry.data.tagi.map((tag) => <a class="pill" href="#co-mozna">{tag}</a>)}
      </nav>
      <StatRow
        items={entry.data.fakty.map((fact) => ({
          value: fact.wartosc,
          count: fact.liczba,
          label: fact.opis,
        }))}
      />
    </div>
  </section>
  <FormatSlider slides={entry.data.formaty} />
  {feature && (
    <section class="event-spaces reveal" aria-labelledby="miejsca">
      <div class="wrap">
        <header class="event-head">
          <p class="eyebrow">Przestrzeń</p>
          <h2 id="miejsca">Dobierzmy do tego właściwe MIEJSCE</h2>
          <p class="lead">{entry.data.dla_ilu}</p>
        </header>
        <div class="event-stage">
          <a class="event-feature" href={`/przestrzenie/${feature.id}/`}>
            <img src={feature.data.cover} alt="" width="1400" height="900" />
            <div class="event-feature-copy">
              <h3>{feature.data.title}</h3>
              <p>{feature.data.lead}</p>
              <span class="btn btn-ghost">Zobacz {feature.data.title}</span>
            </div>
          </a>
          {restSpaces.length > 0 && (
            <div class="event-side">
              {restSpaces.map((space) => (
                <a class="event-mini" href={`/przestrzenie/${space.id}/`}>
                  <img src={space.data.cover} alt="" width="400" height="300" />
                  <span>
                    <b>{space.data.title}</b>
                    <small>{space.data.lead}</small>
                  </span>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}
  {pierwszy && (
    <section class="event-story reveal" aria-labelledby="scenariusz">
      <div class="wrap event-story-grid">
        <figure class="event-story-photo">
          <img src={pierwszy.data.cover} alt="" width="1400" height="1000" />
        </figure>
        <div>
          <p class="eyebrow">{pierwszy.data.title}</p>
          <h2 id="scenariusz">Przykładowy scenariusz</h2>
          <p class="lead">{pierwszy.data.lead}</p>
          <ol class="event-steps">
            {pierwszy.data.program.map((punkt, index) => (
              <li><b>0{index + 1}</b><span>{punkt.tytul}</span></li>
            ))}
          </ol>
          <p class="fine">Godziny i zakres dopasowujemy do Waszego wydarzenia</p>
          <p class="btn-row"><a class="btn btn-primary" href={`/scenariusze/${pierwszy.id}/`}>Zobacz cały scenariusz</a></p>
        </div>
      </div>
    </section>
  )}
  <section class="event-feast reveal" aria-labelledby="menu-kat">
    <div class="wrap event-feast-grid">
      <div>
        <p class="eyebrow">Kuchnia</p>
        <h2 id="menu-kat">Jedzenie, bar i dobry plan</h2>
        <p class="lead">{entry.data.jedzenie_bar}</p>
        <p>{entry.data.atrakcje}</p>
        <p class="fine">Dodatkowe AV, DJ i oprawa wyceniamy osobno, poza kwotą „od”</p>
        <div class="btn-row">
          <a class="btn btn-ghost" href="/jedzenie-i-bar/">Jedzenie i bar</a>
          <a class="btn btn-primary" href={budzetHref}>Porozmawiajmy o budżecie</a>
        </div>
      </div>
      <aside class="event-note">
        <p class="eyebrow">Plan B</p>
        <p class="lead">{entry.data.plan_b}</p>
      </aside>
    </div>
  </section>
  {sekcje && (
    <Slider
      title={sekcje.film_h}
      note={sekcje.film_body}
      items={sekcje.film_zdjecia.map((src, index) => ({ src, alt: `${sekcje.film_h}, zdjęcie ${index + 1}`, title: sekcje.film_note }))}
    />
  )}
  <section class="event-faq event-tint reveal" aria-labelledby="faq-kat">
    <div class="wrap event-faq-grid">
      <header class="event-head">
        <p class="eyebrow">Pytania</p>
        <h2 id="faq-kat">Zanim napiszesz</h2>
        <p class="lead">Deszcz, godziny, dojazd i menu. Resztę doprecyzujemy w briefie</p>
      </header>
      <div>
        {faq.map(({ item, Content }) => (
          <details class="acc">
            <summary>{item.data.pytanie}</summary>
            <div class="acc-body"><Content /></div>
          </details>
        ))}
      </div>
    </div>
  </section>
  <NextBand
    title={entry.data.cta}
    links={[
      { href: budzetHref, label: "Sprawdź budżet" },
      { href: "/przestrzenie/", label: "Wszystkie przestrzenie" },
      { href: kontaktHref, label: entry.data.cta },
    ]}
    cta={entry.data.cta}
    href={kontaktHref}
  />
</Base>
