---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import NextBand from "../../components/NextBand.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

export async function getStaticPaths() {
  const entries = await getCollection("eventy");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const inne = sortByOrder(await getCollection("eventy")).filter((item) => item.id !== entry.id);
const crumbs = [
  { href: "/eventy/", label: "Eventy" },
  { label: entry.data.title },
];
const budgetType = (id) =>
  id.includes("wesele")
    ? "wesele"
    : id.includes("szkol")
      ? "szkolenie"
      : id.includes("integr")
        ? "integracja"
        : id.includes("premium")
          ? "premiera"
          : id.includes("garden")
            ? "garden-party"
            : id.includes("konfer")
              ? "konferencja"
              : "firmowy";
const osoby = (String(entry.data.tag).match(/(\d+)/) || [])[1] || "";
const typ = budgetType(entry.id);
const budzetHref = `/ceny/?typ=${typ}${osoby ? `&osoby=${osoby}` : ""}#budzet`;
const spaceLinks = [];
const gdzie = entry.data.przestrzen;
if (/CAŁE/i.test(gdzie)) spaceLinks.push({ href: "/przestrzenie/cale-miejsce/", label: "Całe Miejsce" });
if (/NOWE/i.test(gdzie)) spaceLinks.push({ href: "/przestrzenie/nowe-miejsce/", label: "Nowe Miejsce" });
if (/DUŻE/i.test(gdzie)) spaceLinks.push({ href: "/przestrzenie/duze-miejsce/", label: "Duże Miejsce" });
if (/OGRÓD/i.test(gdzie)) spaceLinks.push({ href: "/przestrzenie/ogrod/", label: "Ogród" });
---

<Base
  title={`${entry.data.title} | MIEJSCE`}
  description={entry.data.opis_seo}
  image={entry.data.cover}
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, { href: "/eventy/", label: "Eventy" }, { href: `/eventy/${entry.id}/`, label: entry.data.title }])]}
>
  <PageHero
    crumbs={crumbs}
    kicker={entry.data.tag}
    title={entry.data.title}
    lede={entry.data.lead}
    image={entry.data.cover}
    imageAlt={entry.data.title}
  />

  <section class="band">
    <div class="wrap split">
      <div class="stack">
        <p class="meta">Liczba gości: {osoby ? `${osoby} osób` : entry.data.tag}</p>
        <div class="prose"><Content /></div>
        <SectionHeader eyebrow="Dzień" title="Jak układa się ten scenariusz" />
        <ol class="timeline">
          {
            entry.data.program.map((punkt) => (
              <li>
                <span class="when">{punkt.godzina}</span>
                <div>
                  <h3>{punkt.tytul}</h3>
                  <p>{punkt.opis}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <aside class="card stack pad">
        <p class="eyebrow">Przestrzeń</p>
        <h3>{entry.data.przestrzen}</h3>
        <ul class="included">
          {entry.data.zakres.map((item) => <li>{item}</li>)}
        </ul>
        <div class="stack">
          {spaceLinks.map((link) => <a class="btn btn-ghost" href={link.href}>{link.label}</a>)}
        </div>
        <a class="btn btn-primary" href={budzetHref}>Sprawdź budżet</a>
      </aside>
    </div>
  </section>

  <section class="band band-dark">
    <div class="wrap stack-lg">
      <SectionHeader eyebrow="Galeria" title="Tak to wygląda" lead="Zdjęcia z tej przestrzeni i podobnych wieczorów." />
      <div class="gallery-row">
        {entry.data.zdjecia.slice(0, 3).map((src) => <img src={src} alt={entry.data.title} />)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <SectionHeader eyebrow="Inne układy" title="Zobacz też" />
      <div class="cards-3">
        {
          inne.slice(0, 3).map((event) => (
            <article class="media-card">
              <a href={`/eventy/${event.id}/`}>
                <img src={event.data.cover} alt="" />
                <div class="card-body">
                  <p class="eyebrow">{event.data.tag}</p>
                  <h3>{event.data.title}</h3>
                  <span class="btn btn-ghost">Zobacz scenariusz</span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <NextBand
    kicker="Następny krok"
    title="Policz budżet albo napisz"
    links={[
      { href: budzetHref, label: "Moduł budżetu, uzupełniony tym scenariuszem" },
      { href: "/przestrzenie/", label: "Przestrzenie" },
      { href: "/jedzenie-i-bar/", label: "Jedzenie i bar" },
    ]}
    cta="Sprawdź budżet"
    href={budzetHref}
  />
</Base>
