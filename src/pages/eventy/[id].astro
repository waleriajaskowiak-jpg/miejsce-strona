---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import NextBand from "../../components/NextBand.astro";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

export async function getStaticPaths() {
  const entries = await getCollection("eventy");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const inne = sortByOrder(await getCollection("eventy")).filter((item) => item.id !== entry.id);
const crumbs = [
  { href: "/eventy/", label: "Eventy" },
  { label: entry.data.title },
];
---

<Base
  title={`${entry.data.title} | MIEJSCE`}
  description={entry.data.opis_seo}
  image={entry.data.cover}
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, { href: "/eventy/", label: "Eventy" }, { href: `/eventy/${entry.id}/`, label: entry.data.title }])]}
>
  <header class="wrap page-hero">
    <Crumbs items={crumbs} />
    <p class="kicker">{entry.data.tag}</p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.lead}</p>
    <p class="meta-line">{entry.data.przestrzen}</p>
  </header>
  <section class="sec" style="padding-top:1rem">
    <div class="wrap split">
      <div>
        <div class="prose"><Content /></div>
        <p class="kicker" style="margin-top:1.5rem">Scenariusz dnia</p>
        <ol class="timeline">
          {
            entry.data.program.map((punkt) => (
              <li>
                <span class="when">{punkt.godzina}</span>
                <div>
                  <h3>{punkt.tytul}</h3>
                  <p>{punkt.opis}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <figure class="print tilt-r land">
          <img src={entry.data.cover} alt={entry.data.title} />
        </figure>
        <p class="kicker" style="margin-top:1.6rem">Zakres</p>
        <ul class="spec-list">
          {entry.data.zakres.map((item) => <li>{item}</li>)}
        </ul>
        <div class="btn-row">
          <a class="btn" href="/ceny/">Sprawdź budżet</a>
          <a class="btn ghost" href={`/kontakt/?wiadomosc=${encodeURIComponent(`Chcę porozmawiać o scenariuszu: ${entry.data.title}.`)}#brief`}>Napisz do nas</a>
        </div>
      </div>
    </div>
  </section>
  <section class="sec" style="padding-top:0">
    <div class="wrap mosaic">
      {
        entry.data.zdjecia.slice(0, 3).map((src, index) => (
          <figure class:list={["print", index === 0 ? "big tilt-l land" : "tilt-r"]}>
            <img src={src} alt="" loading="lazy" />
          </figure>
        ))
      }
    </div>
  </section>
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <h2>Inne scenariusze</h2>
      <ol class="scenario-index">
        {
          inne.map((event, index) => (
            <li>
              <a href={`/eventy/${event.id}/`}>
                <span class="num">{String(index + 1).padStart(2, "0")}</span>
                <span>
                  <strong>{event.data.title}</strong>
                  <em>{event.data.tag}</em>
                </span>
                <img src={event.data.cover} alt="" loading="lazy" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <NextBand
    kicker="Następny krok"
    title="Policz budżet albo napisz"
    links={[
      { href: "/ceny/#budzet", label: "Moduł budżetu" },
      { href: "/przestrzenie/", label: "Przestrzenie" },
      { href: "/jedzenie-i-bar/", label: "Jedzenie i bar" },
    ]}
    cta="Wyślij brief"
  />
</Base>
