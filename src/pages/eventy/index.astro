---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import NextBand from "../../components/NextBand.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { podstrony, crumb } from "../../lib/copy.js";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

const page = podstrony.eventy;

const kategorie = sortByOrder(await getCollection("kategorie"));
const scenariusze = sortByOrder(await getCollection("scenariusze")).slice(0, 3);
const crumbs = [{ href: "/eventy/", label: crumb("/eventy/") }];
---

<Base
  title={page.tytul}
  description={page.opis}
  jsonLd={[crumbsJsonLd([{ href: "/", label: crumb("/") }, ...crumbs])]}
>
  <PageHero
    crumbs={crumbs}
    kicker={page.brew}
    title={page.h}
    lede={page.lead}
    image={page.zdjecie}
    imageAlt={page.alt}
  />
  <section class="band" aria-labelledby="rodzaje">
    <div class="wrap">
      <SectionHeader eyebrow={page.brew_karty} title={page.karty_h} lead={page.karty_lead} />
      <div class="cards-2" id="rodzaje">
        {kategorie.map((item) => (
          <article class="media-card">
            <a href={`/eventy/${item.id}/`}>
              <img src={item.data.cover} alt="" />
              <div class="card-body">
                <p class="event-tag" style={`--event-color:${item.data.kolor};--event-on:${item.data.kolor_tekst}`}>{item.data.nav_label}</p>
                <h3>{item.data.title}</h3>
                <p>{item.data.lead}</p>
                <span class="btn btn-primary">{item.data.cta}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="band band-surface" aria-labelledby="gotowe">
    <div class="wrap">
      <SectionHeader eyebrow={page.albo} title={page.scenariusz_h} lead={page.scenariusz_lead} />
      <div class="cards-3" id="gotowe">
        {scenariusze.map((event) => (
          <article class="media-card">
            <a href={`/scenariusze/${event.id}/`}>
              <img src={event.data.cover} alt="" />
              <div class="card-body">
                <p class="eyebrow">{event.data.tag}</p>
                <h3>{event.data.title}</h3>
                <span class="btn btn-ghost">{page.zobacz}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
      <p class="btn-row"><a class="btn btn-ghost" href="/scenariusze/">{page.wszystkie}</a></p>
    </div>
  </section>
  <NextBand
    title={page.nastepny}
    links={[
      { href: "/przestrzenie/", label: page.link_przestrzenie }, { href: "/ceny/#estymator", label: page.link_budzet }, { href: "/kontakt/", label: page.cta }, ]}
  />
</Base>
