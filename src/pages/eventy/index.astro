---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

const eventy = sortByOrder(await getCollection("eventy"));
const crumbs = [{ href: "/eventy/", label: "Eventy" }];
---

<Base
  title="Scenariusze eventów nad wodą | MIEJSCE"
  description="Konferencja z afterparty, szkolenie z kolacją, integracja, premiera, wesele i garden party. Każdy scenariusz ma własną stronę."
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, ...crumbs])]}
>
  <header class="wrap page-hero">
    <Crumbs items={crumbs} />
    <p class="kicker">Scenariusze</p>
    <h1>Tak może wyglądać dzień.</h1>
    <p class="lede">Sześć układów, od sali konferencyjnej po parkiet. Program dnia jest z obecnej oferty, ceny są na osobnej stronie.</p>
  </header>
  <section class="sec" style="padding-top:1rem">
    <div class="wrap">
      <ol class="scenario-index">
        {
          eventy.map((event, index) => (
            <li>
              <a href={`/eventy/${event.id}/`}>
                <span class="num">{String(index + 1).padStart(2, "0")}</span>
                <span>
                  <strong>{event.data.title}</strong>
                  <em>{event.data.lead}</em>
                </span>
                <img src={event.data.cover} alt="" loading="lazy" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
