---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import NextBand from "../../components/NextBand.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

const kategorie = sortByOrder(await getCollection("kategorie"));
const scenariusze = sortByOrder(await getCollection("scenariusze")).slice(0, 3);
const crumbs = [{ href: "/eventy/", label: "Wydarzenia" }];
---

<Base
  title="Rodzaje eventów nad wodą w Warszawie | MIEJSCE"
  description="Cztery rodzaje wydarzeń nad Wisłą: firma, konferencja, wesele i premiera. Każdy ma własną stronę i scenariusz."
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, ...crumbs])]}
>
  <PageHero
    crumbs={crumbs}
    kicker="Wybierz potrzebę"
    title="Co planujesz?"
    lede="Najpierw rodzaj wydarzenia, potem przestrzeń i scenariusz. Ceny zostają na osobnej stronie."
    image="/img/gallery/dm20.jpg"
    imageAlt="Wieczór na barce"
  />
  <section class="band" aria-labelledby="rodzaje">
    <div class="wrap">
      <SectionHeader eyebrow="Wydarzenia" title="Cztery drogi" lead="Każda karta prowadzi do jednej strony. Tam są przestrzenie, scenariusz i link do budżetu." />
      <div class="cards-2" id="rodzaje">
        {kategorie.map((item) => (
          <article class="media-card">
            <a href={`/eventy/${item.id}/`}>
              <img src={item.data.cover} alt="" />
              <div class="card-body">
                <p class="eyebrow">{item.data.nav_label}</p>
                <h3>{item.data.title}</h3>
                <p>{item.data.lead}</p>
                <span class="btn btn-primary">{item.data.cta}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="band band-surface" aria-labelledby="gotowe">
    <div class="wrap">
      <SectionHeader eyebrow="Albo od końca" title="A może gotowy scenariusz?" lead="Trzy przykłady. Reszta jest na liście scenariuszy." />
      <div class="cards-3" id="gotowe">
        {scenariusze.map((event) => (
          <article class="media-card">
            <a href={`/scenariusze/${event.id}/`}>
              <img src={event.data.cover} alt="" />
              <div class="card-body">
                <p class="eyebrow">{event.data.tag}</p>
                <h3>{event.data.title}</h3>
                <span class="btn btn-ghost">Zobacz scenariusz</span>
              </div>
            </a>
          </article>
        ))}
      </div>
      <p class="btn-row"><a class="btn btn-ghost" href="/scenariusze/">Wszystkie scenariusze</a></p>
    </div>
  </section>
  <NextBand
    title="Zobacz przestrzeń albo policz budżet"
    links={[
      { href: "/przestrzenie/", label: "Zobacz przestrzenie" },
      { href: "/ceny/#estymator", label: "Sprawdź budżet" },
      { href: "/kontakt/", label: "Zaplanuj event" },
    ]}
  />
</Base>
