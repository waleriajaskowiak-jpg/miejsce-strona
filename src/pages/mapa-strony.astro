---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import NextBand from "../components/NextBand.astro";
import { podstrony, crumb } from "../lib/copy.js";
import { crumbsJsonLd, sortByOrder } from "../lib/nav.js";

const page = podstrony.mapa;

const kategorie = sortByOrder(await getCollection("kategorie"));
const scenariusze = sortByOrder(await getCollection("scenariusze"));
const przestrzenie = sortByOrder(await getCollection("przestrzenie"));
const crumbs = [{ href: "/mapa-strony/", label: page.h }];
---

<Base
  title={page.tytul}
  description={page.opis}
  image={page.zdjecie}
  jsonLd={[crumbsJsonLd([{ href: "/", label: crumb("/") }, ...crumbs])]}
>
  <PageHero
    crumbs={crumbs}
    kicker={page.kicker}
    title={page.h}
    lede={page.lead}
    image={page.zdjecie}
    imageAlt={page.alt}
  />
  <section class="band tight-top">
    <div class="wrap cards-3">
      <article class="info-card">
        <h2>{page.strona}</h2>
        <ul class="spec-list">
          <li><a href="/">{page.home}</a></li>
          <li><a href="/eventy/">{page.rodzaje}</a></li>
          {kategorie.filter((item) => !item.data.szkic).map((item) => <li><a href={`/eventy/${item.id}/`}>{item.data.title}</a></li>)}
          <li><a href="/scenariusze/">{page.scenariusze}</a></li>
          {scenariusze.filter((item) => !item.data.szkic).map((item) => <li><a href={`/scenariusze/${item.id}/`}>{item.data.title}</a></li>)}
        </ul>
      </article>
      <article class="info-card">
        <h2>{page.oferta}</h2>
        <ul class="spec-list">
          <li><a href="/przestrzenie/">{page.przestrzenie}</a></li>
          {przestrzenie.map((item) => <li><a href={`/przestrzenie/${item.id}/`}>{item.data.title}</a></li>)}
          <li><a href="/ceny/">{page.ceny}</a></li>
          <li><a href="/ceny/#estymator">{page.estymator}</a></li>
          <li><a href="/jedzenie-i-bar/">{page.jedzenie}</a></li>
          <li><a href="/galeria/">{page.galeria}</a></li>
        </ul>
      </article>
      <article class="info-card">
        <h2>{page.wiedza}</h2>
        <ul class="spec-list">
          <li><a href="/realizacje/">{page.realizacje}</a></li>
          <li><a href="/warto-wiedziec/">{page.warto}</a></li>
          <li><a href="/poradnik/">{page.poradnik}</a></li>
          <li><a href="/kontakt/">{page.kontakt}</a></li>
          <li><a href="/kontakt/?cel=ogledziny">{page.ogledziny}</a></li>
        </ul>
      </article>
    </div>
  </section>
  <NextBand
    title={page.nastepny}
    links={[
      { href: "/eventy/", label: page.link_rodzaje }, { href: "/ceny/#estymator", label: page.link_budzet }, { href: "/kontakt/", label: page.cta }, ]}
  />
</Base>
