---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import FormBrief from "../components/FormBrief.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { crumbsJsonLd, venueJsonLd } from "../lib/nav.js";

const kontakt = (await getEntry("ustawienia", "kontakt"))!.data;
const cennik = (await getEntry("ustawienia", "cennik"))!.data;
const strona = (await getEntry("ustawienia", "strona"))!.data;
const crumbs = [{ href: "/kontakt/", label: "Kontakt" }];
const wizyta = Astro.url.searchParams.get("cel") === "ogledziny";
const przestrzen = Astro.url.searchParams.get("przestrzen") || "";
const typy = [
  ...cennik.typy_eventu,
  { id: "eventy-firmowe-i-integracje", nazwa: "Event firmowy / integracja" },
  { id: "konferencje-i-szkolenia", nazwa: "Konferencja / szkolenie" },
  { id: "wesela-i-przyjecia-prywatne", nazwa: "Wesele / przyjęcie" },
  { id: "premiery-i-wydarzenia-specjalne", nazwa: "Premiery i wydarzenia specjalne" },
];
const adres = `${kontakt.ulica}, ${kontakt.kod} ${kontakt.miasto}`;
const map = `https://maps.google.com/maps?q=${encodeURIComponent(adres)}&z=16&output=embed`;
const osm = `https://www.openstreetmap.org/search?query=${encodeURIComponent(adres)}`;
const google = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(adres)}`;
const icons = {
  phone: `<path d="M6 3h3l2 5-2 1a12 12 0 0 0 6 6l1-2 5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2z"/>`,
  mail: `<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>`,
  pin: `<path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.4"/>`,
};
---

<Base
  title={wizyta ? "Umów oględziny nad wodą | MIEJSCE" : "Kontakt i brief eventowy | MIEJSCE"}
  description={wizyta ? "Napisz, kiedy chcesz zobaczyć MIEJSCE. Termin wizyty potwierdzimy indywidualnie." : kontakt.opis_seo}
  image="/img/pdf/contact.jpg"
  jsonLd={[
    crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, ...crumbs]),
    venueJsonLd(kontakt, strona.opis_seo),
  ]}
>
  <PageHero
    crumbs={crumbs}
    kicker="Port Czerniakowski"
    title={wizyta ? "Zobacz MIEJSCE. Wyobraź sobie resztę" : strona.kontakt_h}
    lede={wizyta ? "Napisz, kiedy chcesz nas odwiedzić. Termin wizyty potwierdzimy indywidualnie." : "Podaj to, co już wiesz. Resztę ustalimy razem."}
    image="/img/pdf/contact.jpg"
    imageAlt="MIEJSCE od strony wody"
  />

  <section class="band">
    <div class="wrap">
      <div class="contact-3">
        <article class="info-card">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.phone} />
          <p class="eyebrow">Telefon</p>
          <a href={`tel:${kontakt.telefon_href}`}>{kontakt.telefon_wyswietlany}</a>
          <p>{kontakt.ogledziny}</p>
        </article>
        <article class="info-card">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.mail} />
          <p class="eyebrow">Mail</p>
          <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
          <p>Brief z formularza trafia na tę skrzynkę.</p>
        </article>
        <article class="info-card">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.pin} />
          <p class="eyebrow">Adres</p>
          <p><b>{kontakt.ulica}</b><br />{kontakt.kod} {kontakt.miasto}<br />{kontakt.dzielnica}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="band band-dark tight-top">
    <div class="wrap grid-12 align-start">
      <div class="span-7 map-block">
        <p class="eyebrow">Dojazd</p>
        <h2>Jak do nas trafić</h2>
        <p class="lead">{kontakt.dojazd}</p>
        <div class="map-frame">
          <iframe title="Mapa: MIEJSCE, ul. Zaruskiego 1, Warszawa" loading="lazy" src={map}></iframe>
        </div>
        <div class="map-actions">
          <a class="btn btn-primary btn-sm" href={google}>Wyznacz trasę</a>
          <a class="btn btn-ghost btn-sm" href={osm}>Otwórz OpenStreetMap</a>
        </div>
        <p>{kontakt.parking}</p>
      </div>
      <div class="span-5">
        <div class="form-panel pad stack">
          <SectionHeader eyebrow="Brief" title="Napisz, co planujesz" />
          <FormBrief typy={typy} cel={wizyta ? "ogledziny" : "zapytanie"} przestrzen={przestrzen} />
        </div>
      </div>
    </div>
  </section>
</Base>
