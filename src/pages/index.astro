---
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { sortByOrder, venueJsonLd } from "../lib/nav.js";

const strona = (await getEntry("ustawienia", "strona"))!.data;
const cennik = (await getEntry("ustawienia", "cennik"))!.data;
const kontakt = (await getEntry("ustawienia", "kontakt"))!.data;
const fakty = (await getEntry("ustawienia", "fakty"))!.data;
const kategorie = sortByOrder(await getCollection("kategorie"));
const przestrzenie = sortByOrder(await getCollection("przestrzenie"));
const scenariusze = sortByOrder(await getCollection("scenariusze")).filter((item) => !item.data.szkic);
const realizacje = sortByOrder(await getCollection("realizacje")).filter((item) => !item.data.szkic);
const published = realizacje.length > 0;
const inspiracje = published ? realizacje.slice(0, 3) : scenariusze.slice(0, 3);
const colors = {
  "eventy-firmowe-i-integracje": "terakota",
  "konferencje-i-szkolenia": "szalwia",
  "wesela-i-przyjecia-prywatne": "piasek",
  "premiery-i-wydarzenia-specjalne": "petrol",
};
const slides = [
  { src: strona.hero_zdjecie || "/img/hero/barki.jpg", alt: strona.hero_zdjecie_alt || "Barki MIEJSCA w Porcie Czerniakowskim" },
  { src: strona.hero_zdjecie_2 || "/img/gallery/og25.jpg", alt: strona.hero_zdjecie_2_alt || "Miejscowy Ogród" },
  { src: "/img/gallery/dm22.jpg", alt: "Duże Miejsce wieczorem" },
];
const heroWidths = [640, 1024, 1600];
const heroSrcset = (ext) => heroWidths.map((width) => `/img/hero/barki-${width}.${ext} ${width}w`).join(", ");
const heroReady = slides[0].src === "/img/hero/barki.jpg";
const tryb = strona.hero_tryb || "foto";
const ask = fakty.niepogoda_brak || "zapytaj o wariant na niepogodę";
const summer = (value) => (typeof value === "number" ? String(value) : "zapytaj");
const winter = (value) => (typeof value === "number" ? String(value) : ask);
const inspirationIcon = {
  konferencja: "grid",
  szkolenie: "users",
  wesele: "glass",
  integracja: "users",
  premiera: "tag",
  "garden-party": "sun",
  firmowy: "utensils",
};
const spaces = [
  {
    id: "duze",
    title: "Duże Miejsce",
    href: "/przestrzenie/duze-miejsce/",
    photo: "/img/gallery/dm22.jpg",
    meta: `${fakty.przestrzenie.duze.wnetrze_m2} m² + ${fakty.przestrzenie.duze.taras_m2} m² tarasu`,
    price: "od 5 000 zł",
    note: "Zimą bankiet mieści około 120 osób. 350 gości to pojemność całego kompleksu, nie tej barki",
    rows: (fakty.uklady?.duze || []).map((row) => ({
      name: row.nazwa,
      lato: summer(row.lato),
      zima: winter(row.zima),
    })),
  },
  {
    id: "male",
    title: "Małe Miejsce",
    href: "/przestrzenie/nowe-miejsce/",
    photo: "/img/gallery/mm12.jpg",
    meta: `${fakty.przestrzenie.male.wnetrze_m2} m² + ${fakty.przestrzenie.male.taras_m2} m² tarasu`,
    price: "od 3 000 zł",
    note: "Sala i zadaszony taras. Liczba 70 dotyczy znanego układu bankietowego",
    rows: (fakty.uklady?.male || []).map((row) => ({ name: row.nazwa, lato: summer(row.lato), zima: winter(row.zima) })),
  },
  {
    id: "ogrod",
    title: "Miejscowy Ogród",
    href: "/przestrzenie/ogrod/",
    photo: "/img/gallery/og25.jpg",
    meta: `${fakty.przestrzenie.ogrod.powierzchnia_m2} m² · ${fakty.przestrzenie.ogrod.sezon}`,
    price: "wycena indywidualna",
    note: "Sezon maj–wrzesień. Na deszcz nie podajemy liczby",
    rows: (fakty.uklady?.ogrod || []).map((row) => ({ name: row.nazwa, lato: summer(row.lato), zima: winter(row.zima) })),
  },
  {
    id: "cale",
    title: "Całe Miejsce",
    href: "/przestrzenie/cale-miejsce/",
    photo: "/img/gallery/cm01.jpg",
    meta: "Dwie barki, tarasy i Miejscowy Ogród",
    price: "wycena indywidualna",
    note: "Do 350 gości, także w deszczu. To nie znaczy, że każda sala mieści 350",
    rows: (fakty.uklady?.cale || []).map((row) => ({ name: row.nazwa, lato: summer(row.lato), zima: winter(row.zima) })),
  },
];
const endpoint = kontakt.formularz_endpoint || "";
const netlify = !endpoint && kontakt.formularz_netlify !== false;
---

<Base
  title={strona.tytul_seo}
  description={strona.opis_seo}
  image={slides[0].src}
  jsonLd={[venueJsonLd(kontakt, strona.opis_seo, fakty)]}
  preload={true}
  preloadSrcset={heroReady ? heroSrcset("avif") : undefined}
  preloadType={heroReady ? "image/avif" : undefined}
>
  <section class="r12-hero">
    <div class="r12-hero-media">
      {tryb === "wideo" && strona.hero_wideo ? (
        <video src={strona.hero_wideo} poster={slides[0].src} autoplay muted loop playsinline></video>
      ) : tryb === "slider" ? (
        slides.map((slide, index) =>
          index === 0 && heroReady ? (
            <picture class:list={["r12-slide", "is-on"]}>
              <source type="image/avif" srcset={heroSrcset("avif")} sizes="100vw" />
              <source type="image/webp" srcset={heroSrcset("webp")} sizes="100vw" />
              <img src={slide.src} srcset={heroSrcset("jpg")} sizes="100vw" alt={slide.alt} width="1600" height="1066" fetchpriority="high" />
            </picture>
          ) : (
            <img class:list={["r12-slide", index === 0 && "is-on"]} src={slide.src} alt={slide.alt} width="1600" height="1066" />
          ),
        )
      ) : heroReady ? (
        <picture>
          <source type="image/avif" srcset={heroSrcset("avif")} sizes="100vw" />
          <source type="image/webp" srcset={heroSrcset("webp")} sizes="100vw" />
          <img src={slides[0].src} srcset={heroSrcset("jpg")} sizes="100vw" alt={slides[0].alt} width="1600" height="1066" fetchpriority="high" />
        </picture>
      ) : (
        <img src={slides[0].src} alt={slides[0].alt} width="1600" height="1066" fetchpriority="high" />
      )}
    </div>
    <div class="wrap r12-hero-copy">
      <p class="eyebrow">{strona.hero_kicker}</p>
      <h1>{strona.hero_h1}</h1>
      <p class="lead">{strona.hero_lead}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/kontakt/">Zaplanuj wydarzenie</a>
        <a class="btn btn-ghost" href="/przestrzenie/">Zobacz przestrzenie</a>
      </div>
    </div>
  </section>

  <section class="band band-white">
    <ul class="r12-usp wrap">
      <li><Icon name="waves" /><span><b>Nad wodą</b><small>Port Czerniakowski, ok. 10 min do Pałacu Kultury</small></span></li>
      <li><Icon name="grid" /><span><b>Cztery układy</b><small>Duże, Małe, Miejscowy Ogród i Całe Miejsce</small></span></li>
      <li><Icon name="utensils" /><span><b>Własna kuchnia</b><small>Menu od 180 zł netto za osobę</small></span></li>
      <li><Icon name="users" /><span><b>Do 350 gości</b><small>Tylko w Całym Miejscu, także gdy pada</small></span></li>
    </ul>
  </section>

  <section class="band" id="wydarzenia">
    <div class="wrap">
      <p class="eyebrow">02</p>
      <h2>Co możesz u nas zorganizować</h2>
      <div class="r12-tiles">
        {kategorie.map((item) => (
          <a class:list={["r12-tile", colors[item.id]]} href={`/eventy/${item.id}/`}>
            <img src={item.data.cover} alt="" width="1200" height="800" />
            <span class="r12-plate">
              <b>{item.data.nav_label}</b>
              <small>{item.data.lead}</small>
              <span class="go">Zobacz <Icon name="arrow" /></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-sand" id="przestrzenie">
    <div class="wrap">
      <p class="eyebrow">03</p>
      <h2>Nasze przestrzenie</h2>
      <p class="lead">Wybierz układ. Liczby, których nie mamy, zostawiamy jako pytanie, nie jako zgadywanie</p>
      <div class="r12-spaces" data-spaces>
        <div class="r12-space-tabs" role="tablist">
          {spaces.map((space, index) => (
            <button type="button" data-space={space.id} aria-selected={index === 0 ? "true" : "false"}>{space.title}</button>
          ))}
        </div>
        {spaces.map((space, index) => (
          <article class="r12-panel" data-panel={space.id} hidden={index !== 0}>
            <img src={space.photo} alt="" width="1600" height="1000" />
            <div class="r12-panel-body">
              <h3>{space.title}</h3>
              <p class="r12-meta">{space.meta}</p>
              <p class="r12-price">{space.price} <small>5 h · netto · +10% serwisu</small></p>
              <div class="r12-layouts" role="tablist" aria-label="Układ stołów">
                {space.rows.map((row, rowIndex) => (
                  <button type="button" data-layout={rowIndex} aria-selected={rowIndex === 0 ? "true" : "false"}>{row.name}</button>
                ))}
              </div>
              {space.rows.map((row, rowIndex) => (
                <div class="r12-cap" data-cap={rowIndex} hidden={rowIndex !== 0}>
                  <p class="cap-stat"><Icon name="sun" /><span><small>Lato</small><b>{row.lato}</b></span></p>
                  <p class="cap-stat"><Icon name="rain" /><span><small>Zima i deszcz</small><b>{row.zima}</b></span></p>
                </div>
              ))}
              <p class="cap-note">{space.note}</p>
              <a class="btn btn-primary" href={space.href}>Zobacz {space.title}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-white">
    <div class="wrap r12-split">
      <img src="/img/pdf/menu-1.jpg" alt="Danie z kuchni MIEJSCA" width="1400" height="1000" />
      <div>
        <p class="eyebrow">04</p>
        <h2>{strona.jedzenie_h}</h2>
        <p class="lead">{strona.jedzenie_lead}</p>
        <ul class="r12-menu">
          {cennik.catering.map((row) => (
            <li><b>{row.nazwa}</b><span>{row.cena} {row.jednostka}</span></li>
          ))}
        </ul>
        <a class="btn btn-ghost" href="/jedzenie-i-bar/">Jedzenie i bar</a>
      </div>
    </div>
  </section>

  <section class="band band-sand">
    <div class="wrap">
      <p class="eyebrow">05</p>
      <h2>{published ? "Inspiracje i realizacje" : "Inspiracje"}</h2>
      <p class="lead">{published ? "Opublikowane wieczory" : "To scenariusze i zdjęcia miejsca, nie relacja z konkretnego zlecenia. Realizacje uzupełnicie w panelu"}</p>
      <div class="r12-cards">
        {inspiracje.map((item) => (
          <a class="r12-card" href={published ? `/realizacje/${item.id}/` : `/scenariusze/${item.id}/`}>
            <img src={item.data.cover} alt="" width="1200" height="800" />
            <span class="r12-card-body">
              <span class="eyebrow"><Icon name={inspirationIcon[item.data.typ_budzetu] || "tag"} />{published ? item.data.typ : "Inspiracja"}</span>
              <h3>{item.data.title}</h3>
              <span class="r12-card-note">{item.data.lead}</span>
              <span class="go">Zobacz <Icon name="arrow" /></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-white" id="zaplanuj">
    <div class="wrap r12-plan">
      <div>
        <p class="eyebrow">06</p>
        <h2>Zaplanuj wydarzenie</h2>
        <p class="lead">Ceny „od”, za 5 godzin, netto. Do kwoty doliczamy 10% serwisu. To nie jest wycena końcowa</p>
        <ul class="r12-menu">
          {cennik.wynajem.map((row) => (
            <li>
              <b>{row.dopisek}</b>
              <span>{row.cena_od ? `od ${row.cena_od.toLocaleString("pl-PL")} zł` : "wycena indywidualna"}</span>
            </li>
          ))}
        </ul>
        <a class="btn btn-primary" href="/ceny/#budzet">Sprawdź orientacyjny budżet</a>
      </div>
      <form class="r12-quick" name="szybki" method="POST" action={endpoint || "/dziekujemy/"} data-netlify={netlify ? "true" : undefined}>
        {netlify && <input type="hidden" name="form-name" value="szybki" />}
        <p class="eyebrow">Szybkie pytanie</p>
        <label>Imię <input name="imie" required autocomplete="given-name" /></label>
        <label>E-mail <input name="email" type="email" required autocomplete="email" /></label>
        <label>Telefon <input name="telefon" type="tel" autocomplete="tel" /></label>
        <label>Termin <input name="data" type="text" placeholder="np. czerwiec 2026" /></label>
        <label>Liczba osób <input name="osoby" type="number" inputmode="numeric" min="1" /></label>
        <button class="btn btn-primary" type="submit">Wyślij zapytanie</button>
        <a class="text-link" href="/kontakt/#brief">Chcę podać więcej szczegółów</a>
      </form>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll("[data-spaces]").forEach((root) => {
    const show = (id) => {
      root.querySelectorAll("[data-space]").forEach((button) => {
        button.setAttribute("aria-selected", button.getAttribute("data-space") === id ? "true" : "false");
      });
      root.querySelectorAll("[data-panel]").forEach((panel) => {
        panel.hidden = panel.getAttribute("data-panel") !== id;
      });
    };
    root.querySelectorAll("[data-space]").forEach((button) => {
      button.addEventListener("click", () => show(button.getAttribute("data-space")));
    });
    root.querySelectorAll("[data-panel]").forEach((panel) => {
      panel.querySelectorAll("[data-layout]").forEach((button) => {
        button.addEventListener("click", () => {
          const index = button.getAttribute("data-layout");
          panel.querySelectorAll("[data-layout]").forEach((peer) => {
            peer.setAttribute("aria-selected", peer === button ? "true" : "false");
          });
          panel.querySelectorAll("[data-cap]").forEach((block) => {
            block.hidden = block.getAttribute("data-cap") !== index;
          });
        });
      });
    });
  });
</script>
