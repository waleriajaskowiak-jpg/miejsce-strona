---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Plan from "../components/Plan.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { sortByOrder, venueJsonLd } from "../lib/nav.js";

const strona = (await getEntry("ustawienia", "strona"))!.data;
const cennik = (await getEntry("ustawienia", "cennik"))!.data;
const kontakt = (await getEntry("ustawienia", "kontakt"))!.data;
const fakty = (await getEntry("ustawienia", "fakty"))!.data;
const loga = (await getEntry("ustawienia", "loga"))!.data;
const galeria = (await getEntry("ustawienia", "galeria"))!.data;
const kategorie = sortByOrder(await getCollection("kategorie"));
const scenariusze = sortByOrder(await getCollection("scenariusze"));
const przestrzenie = sortByOrder(await getCollection("przestrzenie"));
const faqAll = sortByOrder(await getCollection("faq")).slice(0, 4);
const faq = [];
for (const entry of faqAll) {
  const { Content } = await render(entry);
  faq.push({ entry, Content });
}
const heroSlides = [
  { src: strona.hero_zdjecie, alt: strona.hero_zdjecie_alt },
  { src: "/img/gallery/dm22.jpg", alt: "Duże Miejsce nocą" },
  { src: strona.hero_zdjecie_2, alt: strona.hero_zdjecie_2_alt },
  { src: "/img/gallery/ws01.jpg", alt: "Przyjęcie na barce" },
];
const published = sortByOrder(await getCollection("realizacje")).filter((item) => !item.data.szkic);
const strip = (galeria.kategorie || []).flatMap((cat) => cat.zdjecia || []).slice(0, 4);
---

<Base
  title={strona.tytul_seo}
  description={strona.opis_seo}
  image={strona.hero_zdjecie}
  jsonLd={[venueJsonLd(kontakt, strona.opis_seo, fakty)]}
  overlay={true}
  preload={true}
>
  <section class="cine" aria-label="MIEJSCE">
    <div class="cine-media" id="heroMedia">
      {
        heroSlides.map((slide, index) => (
          <img
            class:list={["hs", index === 0 && "is-on"]}
            src={index === 0 ? slide.src : undefined}
            data-src={index === 0 ? undefined : slide.src}
            alt={slide.alt || ""}
            width="1465"
            height="1700"
            fetchpriority={index === 0 ? "high" : undefined}
          />
        ))
      }
    </div>
    <div class="cine-shade"></div>
    <button class="hero-pause btn btn-ghost" id="heroPause" type="button" aria-pressed="false">Pauza</button>
    <div class="wrap cine-bottom">
      <div>
        <p class="eyebrow">{strona.hero_kicker}</p>
        <h1>{strona.hero_h1}</h1>
      </div>
      <div>
        <p class="lede">{strona.hero_lead}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/kontakt/">Zaplanuj event</a>
          <a class="btn btn-ghost" href="/przestrzenie/">Zobacz przestrzenie</a>
        </div>
      </div>
    </div>
    <div class="wrap">
      <ul class="stat-row">
        <li><b>{fakty.przestrzenie.cale.maks_osob}</b><span>gości</span></li>
        <li><b>2</b><span>barki</span></li>
        <li><b>1</b><span>ogród</span></li>
        <li><b>10 min</b><span>do Pałacu Kultury, Śródmieście</span></li>
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="rodzaje-home">
    <div class="wrap">
      <SectionHeader eyebrow="Wydarzenia" title="Co planujesz?" lead="Cztery rodzaje. Każdy ma własną stronę, przestrzeń i scenariusz." />
      <div class="cards-2" id="rodzaje-home">
        {kategorie.map((item) => (
          <article class="media-card">
            <a href={`/eventy/${item.id}/`}>
              <img src={item.data.cover} alt="" />
              <div class="card-body">
                <p class="eyebrow">{item.data.nav_label}</p>
                <h3>{item.data.title}</h3>
                <p>{item.data.lead}</p>
                <span class="btn btn-primary">{item.data.cta}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="plan-band" id="plan" aria-labelledby="plan-h">
    <div class="wrap">
      <SectionHeader eyebrow="Przestrzenie" title={strona.przestrzenie_h} lead={strona.przestrzenie_lead} />
      <div class="cards-3">
        {przestrzenie.filter((item) => item.id !== "cale-miejsce").map((space) => (
          <article class="media-card">
            <a href={`/przestrzenie/${space.id}/`}>
              <img src={space.data.cover} alt="" />
              <div class="card-body">
                <h3>{space.data.title}</h3>
                <p>{space.data.meta}</p>
                <span class="btn btn-ghost">Zobacz {space.data.title}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
      <article class="feature eat-follow">
        <a class="feature-media" href="/przestrzenie/cale-miejsce/">
          <img src="/img/gallery/og05.jpg" alt="Całe Miejsce z ogrodem" />
        </a>
        <div class="feature-copy">
          <p class="eyebrow">Całe Miejsce</p>
          <h2 id="plan-h">Jedno MIEJSCE na cały dzień</h2>
          <p class="lead">Dwie barki, tarasy i ogród. Do {fakty.przestrzenie.cale.maks_osob} gości, także w deszczu.</p>
          <a class="btn btn-primary" href="/przestrzenie/cale-miejsce/">Zobacz całe Miejsce</a>
        </div>
      </article>
      <Plan spaces={przestrzenie} />
    </div>
  </section>

  <section class="band" aria-label="Przykładowy scenariusz">
    <div class="wrap">
      <SectionHeader eyebrow="Scenariusz" title="Jak może wyglądać dzień" lead="Wybierz rodzaj. Godziny są na stronie scenariusza, tu tylko przebieg." />
      <div class="tablist" role="tablist" aria-label="Rodzaj">
        {kategorie.map((item, index) => (
          <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1}>{item.data.nav_label}</button>
        ))}
      </div>
      {kategorie.map((item, index) => {
        const first = scenariusze.find((scen) => scen.data.kategorie?.includes(item.id));
        return (
          <div role="tabpanel" hidden={index !== 0}>
            {first && (
              <div class="split">
                <div>
                  <p class="eyebrow">{first.data.title}</p>
                  <h2>Przykładowy scenariusz</h2>
                  <ol class="included">
                    {first.data.program.map((punkt) => <li>{punkt.tytul}</li>)}
                  </ol>
                  <p class="fine">Godziny i zakres dopasowujemy do Waszego wydarzenia.</p>
                  <p class="btn-row"><a class="btn btn-primary" href={`/scenariusze/${first.id}/`}>Zobacz scenariusz</a></p>
                </div>
                <img src={first.data.cover} alt="" />
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <section class="band band-ink" aria-labelledby="teaser-h">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Budżet</p>
        <h2 id="teaser-h">{cennik.budzet_h}</h2>
        <p class="lead">Porównujemy Twój budżet z cenami przestrzeni, menu i baru. Wynik jest orientacyjny.</p>
      </div>
      <form class="stack" action="/ceny/#estymator" method="get">
        <label class="field">
          <span>Rodzaj</span>
          <select name="typ">
            {cennik.typy_eventu.map((typ) => <option value={typ.id}>{typ.nazwa}</option>)}
          </select>
        </label>
        <label class="field">
          <span>Liczba gości</span>
          <input name="osoby" type="number" min="10" max={fakty.przestrzenie.cale.maks_osob} value="80" />
        </label>
        <label class="field">
          <span>Budżet netto</span>
          <input name="budzet" type="number" min="5000" step="1000" value="40000" />
        </label>
        <button class="btn btn-primary" type="submit">Sprawdź budżet</button>
      </form>
    </div>
  </section>

  <section class="band" aria-labelledby="dowod">
    <div class="wrap">
      <SectionHeader eyebrow="Realizacje" title="Zdjęcia z wody" lead="Pełne historie czekają na uzupełnienie. Na razie archiwum zdjęć." />
      <div class="cards-2" id="dowod">
        {(published.length ? published.map((item) => item.data.cover) : strip).map((src) => (
          <a href="/galeria/"><img src={typeof src === "string" ? src : src} alt="Zdjęcie z MIEJSCA" /></a>
        ))}
      </div>
      <div class="logo-row eat-follow">
        {loga.loga.map((logo) => <img src={logo.src} alt={logo.alt || ""} />)}
      </div>
      <p class="btn-row"><a class="btn btn-ghost" href="/galeria/">Otwórz galerię</a></p>
    </div>
  </section>

  <section class="band band-dark" aria-labelledby="jedzenie-home">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Jedzenie i bar</p>
        <h2 id="jedzenie-home">{strona.jedzenie_h}</h2>
        <p class="lead">{strona.jedzenie_lead}</p>
        <a class="btn btn-primary" href="/jedzenie-i-bar/">Zobacz jedzenie i bar</a>
      </div>
      <ul class="included">
        {cennik.catering.map((row) => <li>{row.nazwa}: {row.cena} {row.jednostka}</li>)}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="faq-home">
    <div class="wrap">
      <SectionHeader eyebrow="Warto wiedzieć" title={strona.wiedza_h} lead="Cztery odpowiedzi na start." />
      <div id="faq-home">
        {faq.map(({ entry, Content }) => (
          <details class="acc">
            <summary>{entry.data.pytanie}</summary>
            <div class="acc-body"><Content /></div>
          </details>
        ))}
      </div>
      <p class="btn-row"><a class="btn btn-ghost" href="/warto-wiedziec/">Wszystkie odpowiedzi</a></p>
    </div>
  </section>

  <section class="next-band" aria-label="Kontakt">
    <div class="wrap next-grid">
      <div class="next-copy">
        <p class="kicker">Kontakt</p>
        <h2>{strona.kontakt_h}</h2>
        <p class="lead">{kontakt.ulica}, {kontakt.dzielnica}</p>
      </div>
      <div class="next-actions">
        <a class="btn btn-primary" href="/kontakt/">Zaplanuj event</a>
        <a class="btn btn-ghost" href="/kontakt/?cel=ogledziny">Umów oględziny</a>
      </div>
    </div>
  </section>
</Base>
<script>
  const root = document.querySelector('[aria-label="Przykładowy scenariusz"]');
  const tabs = [...(root?.querySelectorAll('[role="tab"]') || [])];
  const panels = [...(root?.querySelectorAll('[role="tabpanel"]') || [])];
  const select = (index) => {
    tabs.forEach((tab, i) => {
      const on = i === index;
      tab.setAttribute("aria-selected", on ? "true" : "false");
      tab.tabIndex = on ? 0 : -1;
      panels[i].hidden = !on;
    });
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => select(index));
    tab.addEventListener("keydown", (event) => {
      if (!["ArrowRight", "ArrowLeft", "Home", "End"].includes(event.key)) return;
      event.preventDefault();
      const next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : event.key === "ArrowRight" ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
      select(next);
      tabs[next].focus();
    });
  });
</script>
