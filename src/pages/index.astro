---
import { getImage } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import barkiPano from "../assets/hero/barki-pano.jpg";
import weseleHero from "../assets/hero/wesele.jpg";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { etykiety, podstrony, sekcje } from "../lib/copy.js";
import { sortByOrder, venueJsonLd, zloty } from "../lib/nav.js";

const strona = (await getEntry("ustawienia", "strona"))!.data;
const home = sekcje;
const form = etykiety.formularz;
const cennik = (await getEntry("ustawienia", "cennik"))!.data;
const kontakt = (await getEntry("ustawienia", "kontakt"))!.data;
const fakty = (await getEntry("ustawienia", "fakty"))!.data;
const kategorie = sortByOrder(await getCollection("kategorie"));
const przestrzenie = sortByOrder(await getCollection("przestrzenie"));
const scenariusze = sortByOrder(await getCollection("scenariusze")).filter((item) => !item.data.szkic);
const realizacje = sortByOrder(await getCollection("realizacje")).filter((item) => !item.data.szkic);
const published = realizacje.length > 0;
const inspiracje = published ? realizacje.slice(0, 3) : scenariusze.slice(0, 3);
const toneById = Object.fromEntries(kategorie.map((item) => [item.id, item.data]));
const heroFiles = {
  "/img/hero/barki-pano.jpg": barkiPano,
  "/img/hero/wesele.jpg": weseleHero,
};
const heroRaw = (strona.hero_slajdy?.length ? strona.hero_slajdy : [
  { src: strona.hero_zdjecie, alt: strona.hero_zdjecie_alt },
]).filter((slide) => slide?.src);
const heroWidths = [750, 1200, 1600, 1920, 2256];
const heroSlides = [];
for (const slide of heroRaw) {
  const file = heroFiles[slide.src];
  const fit = String(slide.src).includes("wesele") ? "wesele" : String(slide.src).includes("barki") ? "pano" : "center";
  if (!file) {
    heroSlides.push({ src: slide.src, alt: slide.alt || "", fit, avif: "", webp: "", eager: heroSlides.length === 0 });
    continue;
  }
  const widths = heroWidths.filter((width) => width <= file.width);
  const srcsetFor = async (format, quality) => {
    const parts = [];
    for (const width of widths) {
      const image = await getImage({ src: file, width, format, quality });
      parts.push(`${image.src} ${width}w`);
    }
    return parts.join(", ");
  };
  const fallback = await getImage({ src: file, width: Math.min(1600, file.width), format: "jpeg", quality: 75 });
  heroSlides.push({
    src: fallback.src,
    alt: slide.alt || "",
    fit,
    width: file.width,
    height: file.height,
    avif: await srcsetFor("avif", 48),
    webp: await srcsetFor("webp", 70),
    eager: heroSlides.length === 0,
  });
}
const tryb = strona.hero_tryb === "foto" ? "zdjecie" : (strona.hero_tryb || "zdjecie");
const summer = (value) => (typeof value === "number" ? String(value) : etykiety.zapytaj);
const winter = summer;
const kiedy = fakty.przestrzenie.cale.maks_kiedy || podstrony.przestrzen.fallback_kiedy;
const inspirationIcon = {
  konferencja: "grid", szkolenie: "users", wesele: "glass", integracja: "users", premiera: "tag", "garden-party": "sun", firmowy: "utensils", };
const card = Object.fromEntries(home.karty.map((item) => [item.id, item]));
const spaces = [
  {
    id: "duze", title: card.duze.tytul, href: card.duze.href, photo: card.duze.zdjecie, meta: `${fakty.przestrzenie.duze.wnetrze_m2}\u00A0m² + ${fakty.przestrzenie.duze.taras_m2}\u00A0m² tarasu`, price: `${etykiety.od} ${zloty(fakty.przestrzenie.duze.cena_od)}`, note: card.duze.dopisek.replace("{kiedy}", kiedy), rows: (fakty.uklady?.duze || []).map((row) => ({
      name: row.nazwa, lato: summer(row.lato), zima: winter(row.zima), })), }, {
    id: "male", title: card.male.tytul, href: card.male.href, photo: card.male.zdjecie, meta: `${fakty.przestrzenie.male.wnetrze_m2}\u00A0m² + ${fakty.przestrzenie.male.taras_m2}\u00A0m² tarasu`, price: `${etykiety.od} ${zloty(fakty.przestrzenie.male.cena_od)}`, note: card.male.dopisek, rows: (fakty.uklady?.male || []).map((row) => ({ name: row.nazwa, lato: summer(row.lato), zima: winter(row.zima) })), }, {
    id: "ogrod", title: card.ogrod.tytul, href: card.ogrod.href, photo: card.ogrod.zdjecie, meta: `${fakty.przestrzenie.ogrod.powierzchnia_m2}\u00A0m² · ${fakty.przestrzenie.ogrod.sezon}`, price: etykiety.wycena_indywidualna, note: card.ogrod.dopisek, rows: (fakty.uklady?.ogrod || []).map((row) => ({ name: row.nazwa, lato: summer(row.lato), zima: winter(row.zima) })), }, {
    id: "cale", title: card.cale.tytul, href: card.cale.href, photo: card.cale.zdjecie, meta: card.cale.meta, price: etykiety.wycena_indywidualna, note: card.cale.dopisek.replace("{kiedy}", kiedy), rows: (fakty.uklady?.cale || []).map((row) => ({ name: row.nazwa, lato: summer(row.lato), zima: winter(row.zima) })), }, ];
const venue = spaces.map((space) => ({
  id: space.id,
  skrot: card[space.id].skrot || space.title,
  title: space.title,
  href: space.href,
  photo: space.photo,
  meta: space.meta,
  price: space.price,
  note: przestrzenie.find((item) => space.href === `/przestrzenie/${item.id}/`)?.data.lead || space.note,
}));
const venueJson = JSON.stringify(venue).replace(/</g, "\\u003c");
const venueFirst = venue[0];
const endpoint = kontakt.formularz_endpoint || "";
const netlify = !endpoint && kontakt.formularz_netlify !== false;
---

<Base
  title={strona.tytul_seo}
  description={strona.opis_seo}
  image={heroRaw[0]?.src || strona.hero_zdjecie}
  jsonLd={[venueJsonLd(kontakt, strona.opis_seo, fakty)]}
  preload={heroSlides[0]?.avif ? true : false}
  preloadHref={heroSlides[0]?.avif?.split(" ")[0]}
  preloadSrcset={heroSlides[0]?.avif || undefined}
  preloadType={heroSlides[0]?.avif ? "image/avif" : undefined}
>
  <section class="r12-hero">
    <div class="r12-hero-media" data-hero>
      {tryb === "wideo" && strona.hero_wideo ? (
        <video src={strona.hero_wideo} poster={heroSlides[0]?.src} autoplay muted loop playsinline></video>
      ) : heroSlides.map((slide, index) => (
        <picture class:list={["r12-slide", index === 0 && "is-on"]} data-hero-slide>
          {slide.avif && <source type="image/avif" srcset={slide.avif} sizes="100vw" />}
          {slide.webp && <source type="image/webp" srcset={slide.webp} sizes="100vw" />}
          <img
            src={slide.src}
            alt={slide.alt}
            width={slide.width || 1600}
            height={slide.height || 900}
            data-fit={slide.fit}
            loading={slide.eager ? "eager" : "lazy"}
            fetchpriority={slide.eager ? "high" : "low"}
            decoding={slide.eager ? "sync" : "async"}
          />
        </picture>
      ))}
      {heroSlides.length > 1 && (
        <div class="r12-hero-dots" aria-hidden="true">
          {heroSlides.map((_, index) => <i class:list={[index === 0 && "is-on"]}></i>)}
        </div>
      )}
    </div>
    <div class="wrap r12-hero-copy">
      <p class="eyebrow">{strona.hero_kicker}</p>
      <h1>{strona.hero_h1}</h1>
      <p class="lead">{strona.hero_lead}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/kontakt/">{home.hero_cta}</a>
        <a class="btn btn-ghost" href="/przestrzenie/">{home.hero_drugi}</a>
      </div>
    </div>
  </section>

  <section class="band band-white">
    <ul class="r12-usp wrap">
      {home.atuty.map((item) => (
        <li><Icon name={item.ikona} /><span><b>{item.tytul}</b><small>{item.opis}</small></span></li>
      ))}
    </ul>
  </section>

  <section class="band" id="wydarzenia">
    <div class="wrap">
      <p class="eyebrow">{home.wydarzenia_brew}</p>
      <h2>{home.wydarzenia_h}</h2>
      <div class="r12-tiles">
        {kategorie.map((item) => (
          <a class="r12-tile" style={`--event-color:${item.data.kolor};--event-on:${item.data.kolor_tekst}`} href={`/eventy/${item.id}/`}>
            <img src={item.data.cover} alt="" width="1200" height="800" />
            <span class="r12-plate">
              <b>{item.data.nav_label}</b>
              <small>{item.data.lead}</small>
              <span class="go">{item.data.cta} <Icon name="arrow" /></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-sand" id="przestrzenie">
    <div class="wrap">
      <p class="eyebrow">{home.przestrzenie_brew}</p>
      <h2>{home.przestrzenie_h}</h2>
      <p class="lead">{home.przestrzenie_lead}</p>
      <div class="home-venue" data-venue data-zobacz={etykiety.zobacz}>
        <script type="application/json" class="venue-data" set:html={venueJson} />
        <div class="home-venue-map">
          <div class="home-venue-stage">
            <img src={etykiety.plan.zdjecie} alt={etykiety.plan.alt} width="2000" height="1325" />
            <svg class="home-venue-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
              <rect class="zone" data-zone="cale" tabindex="0" role="button" aria-label={card.cale.tytul} x="6.5" y="0.5" width="91" height="94" rx="1.4" ry="2.1"></rect>
              <polygon class="zone is-on" data-zone="duze" tabindex="0" role="button" aria-label={card.duze.tytul} aria-pressed="true" points="31.2,5.6 51.8,5.6 51.8,1.2 83.3,1.2 83.3,50.2 63.8,50.2 63.8,58.8 53.2,58.8 53.2,47.4 31.2,47.4"></polygon>
              <polygon class="zone" data-zone="male" tabindex="0" role="button" aria-label={card.male.tytul} points="10.4,48.6 30.6,48.6 30.6,47.2 43.8,47.2 43.8,86.8 10.4,86.8"></polygon>
              <polygon class="zone" data-zone="ogrod" tabindex="0" role="button" aria-label={card.ogrod.tytul} points="44.8,58.8 93.6,58.8 93.6,73.8 44.8,73.8"></polygon>
            </svg>
            {venue.map((space) => <span class:list={["home-venue-tag", space.id === venueFirst.id && "is-on"]} data-tag={space.id}>{space.skrot}</span>)}
          </div>
          <div class="home-venue-chips" role="tablist">
            {venue.map((space) => (
              <button type="button" data-zone={space.id} aria-selected={space.id === venueFirst.id ? "true" : "false"}>{space.title}</button>
            ))}
          </div>
        </div>
        <a class="home-venue-card is-grow" data-venue-card href={venueFirst.href}>
          <img data-venue-photo src={venueFirst.photo} alt="" width="1600" height="1000" />
          <span class="home-venue-copy">
            <span class="eyebrow">{etykiety.plan.kicker}</span>
            <h3 data-venue-title>{venueFirst.title}</h3>
            <span class="home-venue-note" data-venue-note>{venueFirst.note}</span>
            <span class="home-venue-spec" data-venue-price>{venueFirst.price}</span>
            <span class="btn btn-primary" data-venue-cta>{etykiety.zobacz} {venueFirst.title}</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="band band-white">
    <div class="wrap r12-split">
      <img src={home.jedzenie_zdjecie} alt={home.jedzenie_alt} width="1400" height="1000" />
      <div>
        <p class="eyebrow">{home.jedzenie_brew}</p>
        <h2>{strona.jedzenie_h}</h2>
        <p class="lead">{strona.jedzenie_lead}</p>
        <ul class="r12-menu">
          {cennik.catering.map((row) => (
            <li><b>{row.nazwa}</b><span>{row.cena} {row.jednostka}</span></li>
          ))}
        </ul>
        <a class="btn btn-ghost" href="/jedzenie-i-bar/">{home.jedzenie_link}</a>
      </div>
    </div>
  </section>

  <section class="band band-sand">
    <div class="wrap">
      <p class="eyebrow">{home.inspiracje_brew}</p>
      <h2>{published ? home.inspiracje_h_opublikowane : home.inspiracje_h}</h2>
      <p class="lead">{published ? home.inspiracje_lead_opublikowane : home.inspiracje_lead}</p>
      <div class="r12-cards">
        {inspiracje.map((item) => {
          const tone = toneById[item.data.kategorie?.[0]];
          return (
          <a class="r12-card" style={tone ? `--event-color:${tone.kolor};--event-on:${tone.kolor_tekst}` : undefined} href={published ? `/realizacje/${item.id}/` : `/scenariusze/${item.id}/`}>
            <img src={item.data.cover} alt="" width="1200" height="800" />
            <span class="r12-card-body">
              <span class="event-tag"><Icon name={inspirationIcon[item.data.typ_budzetu] || "tag"} />{published ? item.data.typ : home.inspiracja}</span>
              <h3>{item.data.title}</h3>
              <span class="r12-card-note">{item.data.lead}</span>
              <span class="go">{etykiety.zobacz} <Icon name="arrow" /></span>
            </span>
          </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="band band-white" id="zaplanuj">
    <div class="wrap r12-plan">
      <div>
        <p class="eyebrow">{home.zaplanuj_brew}</p>
        <h2>{home.zaplanuj_h}</h2>
        <p class="lead">{home.zaplanuj_lead}</p>
        <ul class="r12-menu">
          {cennik.wynajem.map((row) => (
            <li>
              <b>{row.dopisek}</b>
              <span>{row.cena_od ? `${etykiety.od} ${zloty(row.cena_od)}` : etykiety.wycena_indywidualna}</span>
            </li>
          ))}
        </ul>
        <a class="btn btn-primary" href="/ceny/#budzet">{home.zaplanuj_cta}</a>
      </div>
      <form class="r12-quick" name="szybki" method="POST" action={endpoint || "/dziekujemy/"} data-netlify={netlify ? "true" : undefined}>
        {netlify && <input type="hidden" name="form-name" value="szybki" />}
        <p class="eyebrow">{form.szybie}</p>
        <label>{form.imie} <input name="imie" required autocomplete="given-name" /></label>
        <label>{form.email} <input name="email" type="email" required autocomplete="email" /></label>
        <label>{form.telefon} <input name="telefon" type="tel" autocomplete="tel" /></label>
        <label>{form.termin} <input name="data" type="text" placeholder={form.placeholder_termin} /></label>
        <label>{form.osoby} <input name="osoby" type="number" inputmode="numeric" min="1" /></label>
        <button class="btn btn-primary" type="submit">{form.wyslij}</button>
        <a class="text-link" href="/kontakt/#brief">{form.wiecej}</a>
      </form>
    </div>
  </section>
</Base>

<script>
  const heroReduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll("[data-hero]").forEach((root) => {
    const slides = [...root.querySelectorAll("[data-hero-slide]")];
    const dots = [...root.querySelectorAll(".r12-hero-dots i")];
    if (heroReduce || slides.length < 2) return;
    let index = 0;
    window.setInterval(() => {
      slides[index].classList.remove("is-on");
      dots[index]?.classList.remove("is-on");
      index = (index + 1) % slides.length;
      slides[index].classList.add("is-on");
      dots[index]?.classList.add("is-on");
    }, 6500);
  });
</script>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll("[data-venue]").forEach((root) => {
    const rows = JSON.parse(root.querySelector(".venue-data")?.textContent || "[]");
    const card = root.querySelector("[data-venue-card]");
    let current = rows[0]?.id;
    const grow = () => {
      if (!card || reduce) return;
      card.classList.remove("is-grow");
      void card.offsetWidth;
      card.classList.add("is-grow");
    };
    const paint = (id, animate) => {
      const row = rows.find((item) => item.id === id);
      if (!row || !card) return;
      current = id;
      root.querySelectorAll(".zone").forEach((zone) => {
        const on = zone.getAttribute("data-zone") === id;
        zone.classList.toggle("is-on", on);
        zone.setAttribute("aria-pressed", on ? "true" : "false");
      });
      root.querySelectorAll(".home-venue-tag").forEach((tag) => tag.classList.toggle("is-on", tag.getAttribute("data-tag") === id));
      root.querySelectorAll(".home-venue-chips button").forEach((button) => {
        button.setAttribute("aria-selected", button.getAttribute("data-zone") === id ? "true" : "false");
      });
      card.href = row.href;
      const photo = card.querySelector("[data-venue-photo]");
      if (photo) photo.src = row.photo;
      const title = card.querySelector("[data-venue-title]");
      if (title) title.textContent = row.title;
      const note = card.querySelector("[data-venue-note]");
      if (note) note.textContent = row.note;
      const price = card.querySelector("[data-venue-price]");
      if (price) price.textContent = row.price;
      const cta = card.querySelector("[data-venue-cta]");
      if (cta) cta.textContent = `${root.getAttribute("data-zobacz") || "Zobacz"} ${row.title}`;
      if (animate) grow();
    };
    root.querySelectorAll("[data-zone]").forEach((node) => {
      const pick = () => paint(node.getAttribute("data-zone"), true);
      node.addEventListener("click", pick);
      node.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        pick();
      });
    });
    paint(current, false);
    if (reduce) card?.classList.remove("is-grow");
    else card?.classList.add("is-grow");
  });
</script>
