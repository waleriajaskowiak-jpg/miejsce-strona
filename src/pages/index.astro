---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import DayTimeline from "../components/DayTimeline.astro";
import SpacePicker from "../components/SpacePicker.astro";
import { sortByOrder, venueJsonLd } from "../lib/nav.js";

const strona = (await getEntry("ustawienia", "strona"))!.data;
const cennik = (await getEntry("ustawienia", "cennik"))!.data;
const kontakt = (await getEntry("ustawienia", "kontakt"))!.data;
const fakty = (await getEntry("ustawienia", "fakty"))!.data;
const loga = (await getEntry("ustawienia", "loga"))!.data;
const kategorie = sortByOrder(await getCollection("kategorie"));
const scenariusze = sortByOrder(await getCollection("scenariusze"));
const przestrzenie = sortByOrder(await getCollection("przestrzenie"));
const faqAll = sortByOrder(await getCollection("faq")).slice(0, 4);
const faq = [];
for (const entry of faqAll) {
  const { Content } = await render(entry);
  faq.push({ entry, Content });
}
const slides = [
  { src: "/img/gallery/dm20.jpg", alt: "Duże Miejsce o zmierzchu", chip: "Duże Miejsce · zmierzch", cap: "Barka nocą, widok z Wisły" },
  { src: "/img/gallery/dm22.jpg", alt: "Duże Miejsce nocą", chip: "Duże Miejsce · noc", cap: "Światła na wodzie" },
  { src: "/img/gallery/og25.jpg", alt: "Ogród MIEJSCA", chip: "Ogród · sezon", cap: "Girlandy i trybuny" },
  { src: "/img/gallery/ws01.jpg", alt: "Przyjęcie na barce", chip: "Wieczór", cap: "Stół nad rzeką" },
];
const photos = [
  { src: "/img/gallery/dm01.jpg", cap: "Kolacja na tarasie" },
  { src: "/img/gallery/cm01.jpg", cap: "Barki od strony Wisły" },
  { src: "/img/gallery/dm04.jpg", cap: "Barka nocą" },
  { src: "/img/gallery/og20.jpg", cap: "Garden party" },
  { src: "/img/gallery/ws01.jpg", cap: "Wesele nad Wisłą" },
  { src: "/img/gallery/og25.jpg", cap: "Ogród, maj–wrzesień" },
];
const logos = [...loga.loga, ...loga.loga];
const h1 = String(strona.hero_h1 || "");
const accent = h1
  .replace("nad wodą", "nad wodą<br>")
  .replace("w centrum", "<span>w centrum</span><br>");
const shortLabel = {
  "eventy-firmowe-i-integracje": "Integracje",
  "konferencje-i-szkolenia": "Konferencje",
  "wesela-i-przyjecia-prywatne": "Wesela",
  "premiery-i-wydarzenia-specjalne": "Premiery",
};
---

<Base
  title={strona.tytul_seo}
  description={strona.opis_seo}
  image="/img/gallery/dm20.jpg"
  jsonLd={[venueJsonLd(kontakt, strona.opis_seo, fakty)]}
  overlay={true}
  preload={true}
>
  <section class="split-hero">
    <div class="wrap">
      <div class="h-copy">
        <div>
          <p class="eyebrow">{strona.hero_kicker}</p>
          <h1 class="d1" set:html={accent}></h1>
          <p class="lead">{strona.hero_lead}</p>
          <div class="btn-row">
            <a class="btn btn-primary" href="/kontakt/">Zaplanuj event</a>
            <a class="btn btn-ghost" href="/przestrzenie/">Zobacz przestrzenie</a>
          </div>
        </div>
        <ul class="stat-row">
          <li><b data-count={fakty.przestrzenie.cale.maks_osob}>{fakty.przestrzenie.cale.maks_osob}</b><span>gości, także w deszczu</span></li>
          <li><b>2</b><span>barki</span></li>
          <li><b data-count={fakty.przestrzenie.ogrod.powierzchnia_m2}>{fakty.przestrzenie.ogrod.powierzchnia_m2}</b><span>m² ogrodu</span></li>
          <li><b>10 min</b><span>do Pałacu Kultury</span></li>
        </ul>
      </div>
      <div class="h-media" id="heroMedia">
        {
          slides.map((slide, index) => (
            <img
              class:list={["hs", index === 0 && "is-on"]}
              src={slide.src}
              alt={slide.alt}
              width="1800"
              height="1200"
              data-chip={slide.chip}
              data-cap={slide.cap}
              fetchpriority={index === 0 ? "high" : undefined}
            />
          ))
        }
        <div class="grain"></div>
        <span class="chip" id="heroChip">{slides[0].chip}</span>
        <div class="h-cap">
          <p><small id="heroCount">01 / 04</small><span id="heroCap">{slides[0].cap}</span></p>
          <button type="button" id="heroPause" aria-label="Pauza" aria-pressed="false"></button>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="rodzaje-home">
    <div class="wrap">
      <div class="sec-top">
        <div>
          <p class="eyebrow">01 · Wydarzenia</p>
          <h2>Co planujesz?</h2>
        </div>
        <div>
          <p>Cztery formaty, każdy z własną przestrzenią, menu i scenariuszem dnia</p>
          <a class="text-link" href="/eventy/">Wszystkie wydarzenia</a>
        </div>
      </div>
      <div class="format-acc">
        {
          kategorie.map((item, index) => (
            <a class:list={["pane", index === 0 && "on"]} href={`/eventy/${item.id}/`}>
              <img src={item.data.cover} alt="" width="1800" height="1200" />
              <span class="idx">0{index + 1}</span>
              <span class="vlab">{shortLabel[item.id] || item.data.nav_label}</span>
              <span class="body">
                <small>{item.data.tagi?.[0]}</small>
                <h3>{item.data.title}</h3>
                <p>{item.data.lead}</p>
                <span class="btn btn-primary">{item.data.cta}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band-ink">
    <div class="wrap">
      <SpacePicker fakty={fakty} spaces={przestrzenie} />
    </div>
  </section>

  <section class="band" aria-label="Przykładowy scenariusz">
    <div class="wrap">
      <div class="sec-top">
        <div>
          <p class="eyebrow">03 · Dzień</p>
          <h2>Jak może wyglądać dzień</h2>
        </div>
        <p>Od porannej sali do parkietu po zmroku. Wybierz format i przesuń dzień</p>
      </div>
      <DayTimeline kategorie={kategorie} scenariusze={scenariusze} />
    </div>
  </section>

  <section class="band band-sand">
    <div class="wrap">
      <div class="sec-top">
        <div>
          <p class="eyebrow">04 · Realizacje</p>
          <h2>Zdjęcia z wody</h2>
        </div>
        <p>Wieczory, które już się odbyły: integracje, wesela, premiery i kolacje na wodzie</p>
      </div>
      <div class="bento">
        {photos.map((photo, index) => (
          <a class={`bento-${index + 1}`} href="/galeria/">
            <img src={photo.src} alt={photo.cap} width="1800" height="1200" />
            <span>{photo.cap}</span>
          </a>
        ))}
      </div>
      <p class="btn-row"><a class="btn btn-ghost" href="/galeria/">Cała galeria</a></p>
    </div>
  </section>

  <section class="logos" aria-label="Zaufali nam">
    <div class="wrap">
      <p>Zaufali nam</p>
      <div class="mq">
        <div class="mq-track">
          {logos.map((logo) => <img src={logo.src.replace("/logo/", "/logo/w-")} alt={logo.alt || ""} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="band band-ink">
    <div class="wrap food">
      <div class="flow">
        <p class="eyebrow">Kuchnia</p>
        <h2>{strona.jedzenie_h}</h2>
        <p class="lead">{strona.jedzenie_lead}</p>
        <a class="btn btn-primary" href="/jedzenie-i-bar/">Zobacz jedzenie i bar</a>
      </div>
      <div class="tiers">
        {cennik.catering.map((row) => (
          <article class="tier">
            <div>
              <b>{row.nazwa}</b>
              <span>{row.opis}</span>
            </div>
            <em>{row.cena}<small>{row.jednostka}</small></em>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="faq-home">
    <div class="wrap">
      <div class="sec-top">
        <div>
          <p class="eyebrow">05 · Przed eventem</p>
          <h2 id="faq-home">{strona.wiedza_h}</h2>
        </div>
        <p>Deszcz, godziny, dojazd i menu, zanim wyślecie brief</p>
      </div>
      <div>
        {faq.map(({ entry, Content }) => (
          <details class="acc">
            <summary>{entry.data.pytanie}</summary>
            <div class="acc-body"><Content /></div>
          </details>
        ))}
      </div>
      <p class="btn-row"><a class="text-link" href="/warto-wiedziec/">Wszystkie odpowiedzi</a></p>
    </div>
  </section>

  <section class="close-band" aria-label="Kontakt">
    <div class="wrap close-grid">
      <img src="/img/gallery/dm22.jpg" alt="Barka MIEJSCA wieczorem" width="1800" height="1200" />
      <div>
        <p class="kicker">Kontakt</p>
        <h2>{strona.kontakt_h}</h2>
        <p class="lead">{kontakt.ulica}, {kontakt.dzielnica}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/kontakt/">Zaplanuj event</a>
          <a class="btn btn-ghost" href="/kontakt/?cel=ogledziny">Umów oględziny</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll(".format-acc .pane").forEach((pane) => {
    pane.addEventListener("mouseenter", () => {
      pane.parentElement?.querySelectorAll(".pane").forEach((item) => item.classList.remove("on"));
      pane.classList.add("on");
    });
  });
</script>
