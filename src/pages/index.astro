---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Budzet from "../components/Budzet.astro";
import Plan from "../components/Plan.astro";
import Gallery from "../components/Gallery.astro";
import Slider from "../components/Slider.astro";
import { sortByOrder, venueJsonLd } from "../lib/nav.js";

const strona = (await getEntry("ustawienia", "strona"))!.data;
const cennik = (await getEntry("ustawienia", "cennik"))!.data;
const kontakt = (await getEntry("ustawienia", "kontakt"))!.data;
const loga = (await getEntry("ustawienia", "loga"))!.data;
const sekcje = (await getEntry("ustawienia", "sekcje"))!.data;
const galeria = (await getEntry("ustawienia", "galeria"))!.data;
const przestrzenie = sortByOrder(await getCollection("przestrzenie"));
const eventy = sortByOrder(await getCollection("eventy"));
const realizacje = sortByOrder(await getCollection("realizacje"));
const artykuly = sortByOrder(await getCollection("artykuly"));
const faqAll = sortByOrder(await getCollection("faq")).slice(0, 5);
const faq = [];
for (const entry of faqAll) {
  const { Content } = await render(entry);
  faq.push({ entry, Content });
}
const heroSlides = [strona.hero_zdjecie, "/img/gallery/dm22.jpg", strona.hero_zdjecie_2, "/img/gallery/ws01.jpg", "/img/gallery/mm12.jpg"];
const icons = {
  woda: `<path d="M2 7c2.5 0 2.5 2 5 2s2.5-2 5-2 2.5 2 5 2 2.5-2 5-2"/><path d="M2 13c2.5 0 2.5 2 5 2s2.5-2 5-2 2.5 2 5 2 2.5-2 5-2"/><path d="M2 19c2.5 0 2.5 2 5 2s2.5-2 5-2 2.5 2 5 2 2.5-2 5-2"/>`,
  barka: `<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>`,
  pin: `<path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/>`,
  lisc: `<path d="M4 20c0-8 5-13 16-13 0 9-5 13-11 13H4z"/><path d="M4 20c3-5 7-8 12-9.5"/>`,
  fala: `<path d="M2 8c2.5 0 2.5 2 5 2s2.5-2 5-2 2.5 2 5 2 2.5-2 5-2"/><path d="M2 15c2.5 0 2.5 2 5 2s2.5-2 5-2 2.5 2 5 2 2.5-2 5-2"/>`,
  box: `<rect x="3" y="7" width="18" height="11" rx="1"/><path d="M7 7v11M11 7v11M15 7v11M19 7v11"/>`,
  star: `<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>`,
};
const klimatIcons = ["fala", "box", "star"];
---

<Base
  title={strona.tytul_seo}
  description={strona.opis_seo}
  image={strona.hero_zdjecie}
  jsonLd={[venueJsonLd(kontakt, strona.opis_seo)]}
  overlay={true}
>
  <section class="cine">
    <div class="cine-media" id="heroMedia">
      {
        heroSlides.map((src, index) => (
          <img
            class:list={["hs", index === 0 && "is-on"]}
            src={index === 0 ? src : undefined}
            data-src={index === 0 ? undefined : src}
            alt={index === 0 ? strona.hero_zdjecie_alt : ""}
            data-parallax={index === 0 ? "" : undefined}
            width="1465"
            height="1700"
            fetchpriority={index === 0 ? "high" : undefined}
          />
        ))
      }
    </div>
    <div class="cine-shade"></div>
    <div class="wrap cine-bottom">
      <div>
        <p class="kicker">{strona.hero_kicker}</p>
        <h1>{strona.hero_h1}</h1>
      </div>
      <div>
        <p class="lede">{strona.hero_lead}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/kontakt/">{strona.cta_glowny}</a>
          <a class="btn btn-ghost" href="/przestrzenie/">{strona.cta_drugi}</a>
        </div>
      </div>
    </div>
    <div class="wrap">
      <ul class="fact-strip">
        <li><b data-count="350">350</b><span>gości</span></li>
        <li><b data-count="2">2</b><span>barki</span></li>
        <li><b data-count="1">1</b><span>ogród</span></li>
        <li><b>10 min</b><span>od centrum Warszawy</span></li>
      </ul>
    </div>
    <a class="scroll-cue" href="#plan" aria-label="Przewiń dalej"><span></span></a>
    <div class="hero-dots" id="heroDots" aria-hidden="true"></div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="kicker">{strona.hero_marka}</p>
      <div class="split">
        <blockquote class="quote-band" style="display:block">
          <p>„{strona.cytat}”</p>
          <footer><b>{strona.cytat_autor}</b><span>{strona.cytat_rola}</span></footer>
        </blockquote>
        <ul class="feature-list">
          {
            sekcje.cechy.map((item) => (
              <li>
                <svg class="fi" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[item.ikona] || icons.woda} />
                <h3>{item.tytul}</h3>
                <p>{item.opis}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <dl class="stats">
        <div><dt>350</dt><dd>osób maksymalnie</dd></div>
        <div><dt>3</dt><dd>przestrzenie nad wodą</dd></div>
        <div><dt>10</dt><dd>minut od centrum Warszawy</dd></div>
      </dl>
      <p class="since">{strona.od_roku}</p>
    </div>
  </section>

  <section class="climate">
    <figure class="climate-media">
      <img src={sekcje.klimat_foto} alt="" data-parallax loading="lazy" />
      <figcaption>
        <h2>{sekcje.klimat_h}</h2>
        <p>{sekcje.klimat_lead}</p>
      </figcaption>
    </figure>
    <div class="wrap">
      <ul class="climate-list">
        {
          sekcje.klimat_punkty.map((item, index) => (
            <li>
              <svg class="fi" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[klimatIcons[index]]} />
              <h3>{item.tytul}</h3>
              <p>{item.opis}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec sec-tint" id="plan">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="kicker">Przestrzenie</p>
          <h2>{strona.przestrzenie_h}</h2>
        </div>
        <p class="sec-note">{strona.przestrzenie_lead}</p>
      </div>
      <Plan spaces={przestrzenie} />
    </div>
  </section>

  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee">
      {
        [...eventy, ...eventy].map((event) => (
          <span>{event.data.title} <i>/</i></span>
        ))
      }
    </div>
  </div>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="kicker">Eventy</p>
          <h2>{strona.eventy_h}</h2>
        </div>
        <p class="sec-note">{strona.eventy_lead}</p>
      </div>
      <ol class="scenario-index">
        {
          eventy.map((event, index) => (
            <li>
              <a href={`/eventy/${event.id}/`}>
                <span class="num">{String(index + 1).padStart(2, "0")}</span>
                <span>
                  <strong>{event.data.title}</strong>
                  <em>{event.data.tag}</em>
                </span>
                <img src={event.data.cover} alt="" width="760" height="507" loading="lazy" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sec sec-dark">
    <div class="wrap">
      <Budzet cennik={cennik} wariant="krotki" />
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <div>
        <p class="kicker">Jedzenie i bar</p>
        <h2>{strona.jedzenie_h}</h2>
        <p class="sec-lead">{strona.jedzenie_lead}</p>
        <p><a class="link-arrow" href="/jedzenie-i-bar/">Zobacz pełne menu</a></p>
      </div>
      <ul class="menu-lines">
        {
          cennik.catering.map((pakiet) => (
            <li class="menu-line">
              <span>
                <b>{pakiet.nazwa}</b>
                <small>{pakiet.opis}</small>
              </span>
              <span class="sum">{pakiet.cena} {pakiet.jednostka}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Slider
    title={sekcje.atrakcje_h}
    note={sekcje.atrakcje_note}
    items={sekcje.atrakcje.map((item) => ({ src: item.zdjecie, title: item.tytul, caption: item.opis, alt: item.tytul }))}
  />
  <Slider
    title={sekcje.film_h}
    note={sekcje.film_body}
    items={sekcje.film_zdjecia.map((src, index) => ({ src, alt: `${sekcje.film_h} ${index + 1}`, title: sekcje.film_note }))}
  />

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2>{strona.realizacje_h}</h2>
        <p class="sec-note">{strona.realizacje_lead}</p>
      </div>
      <ul class="case-row">
        {
          realizacje.map((item) => (
            <li>
              <a href={`/realizacje/${item.id}/`}>
                <figure class="print land">
                  <img src={item.data.cover} alt="" loading="lazy" />
                </figure>
                {item.data.szkic && <p class="badge">Szkic</p>}
                <h3>{item.data.title}</h3>
                <p>{item.data.meta}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Gallery galeria={galeria} limit={11} anchor={true} />

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2>{strona.wiedza_h}</h2>
      </div>
      {
        faq.map(({ entry, Content }) => (
          <details class="acc">
            <summary>{entry.data.pytanie}</summary>
            <div class="acc-body"><Content /></div>
          </details>
        ))
      }
      <p style="margin-top:16px"><a class="link-arrow" href="/warto-wiedziec/">Wszystkie odpowiedzi</a></p>
    </div>
  </section>

  <section class="clients">
    <p class="kicker" style="text-align:center">{strona.zaufali_h}</p>
    <div class="marquee logo-marquee" aria-hidden="true">
      <div class="marquee-row">
        {loga.loga.map((logo) => <img src={logo.src} alt="" />)}
        {loga.loga.map((logo) => <img src={logo.src} alt="" />)}
      </div>
    </div>
  </section>

  <section class="visit">
    <img src="/img/pdf/contact.jpg" alt="" width="1700" height="893" />
    <div class="visit-copy">
      <h2>{strona.kontakt_h}</h2>
      <p class="lede">{strona.kontakt_lead}</p>
      <a class="btn btn-primary" href="/kontakt/">Umów oględziny</a>
      <a class="phone" href={`tel:${kontakt.telefon_href}`}>{kontakt.telefon_wyswietlany}</a>
    </div>
  </section>
</Base>
