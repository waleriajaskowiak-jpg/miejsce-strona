---
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { etykiety, podstrony, sekcje } from "../lib/copy.js";
import { sortByOrder, venueJsonLd, zloty } from "../lib/nav.js";

const strona = (await getEntry("ustawienia", "strona"))!.data;
const home = sekcje;
const form = etykiety.formularz;
const cennik = (await getEntry("ustawienia", "cennik"))!.data;
const kontakt = (await getEntry("ustawienia", "kontakt"))!.data;
const fakty = (await getEntry("ustawienia", "fakty"))!.data;
const kategorie = sortByOrder(await getCollection("kategorie"));
const przestrzenie = sortByOrder(await getCollection("przestrzenie"));
const scenariusze = sortByOrder(await getCollection("scenariusze")).filter((item) => !item.data.szkic);
const realizacje = sortByOrder(await getCollection("realizacje")).filter((item) => !item.data.szkic);
const published = realizacje.length > 0;
const inspiracje = published ? realizacje.slice(0, 3) : scenariusze.slice(0, 3);
const toneById = Object.fromEntries(kategorie.map((item) => [item.id, item.data]));
const slides = [
  { src: strona.hero_zdjecie, alt: strona.hero_zdjecie_alt }, { src: strona.hero_zdjecie_2, alt: strona.hero_zdjecie_2_alt }, { src: home.hero_slajd_3, alt: home.hero_slajd_3_alt }, ];
const heroWidths = [640, 1024, 1600];
const heroSrcset = (ext) => heroWidths.map((width) => `/img/hero/barki-${width}.${ext} ${width}w`).join(", ");
const heroReady = slides[0].src === "/img/hero/barki.jpg";
const tryb = strona.hero_tryb === "foto" ? "zdjecie" : (strona.hero_tryb || "zdjecie");
const summer = (value) => (typeof value === "number" ? String(value) : etykiety.zapytaj);
const winter = summer;
const kiedy = fakty.przestrzenie.cale.maks_kiedy || podstrony.przestrzen.fallback_kiedy;
const inspirationIcon = {
  konferencja: "grid", szkolenie: "users", wesele: "glass", integracja: "users", premiera: "tag", "garden-party": "sun", firmowy: "utensils", };
const card = Object.fromEntries(home.karty.map((item) => [item.id, item]));
const spaces = [
  {
    id: "duze", title: card.duze.tytul, href: card.duze.href, photo: card.duze.zdjecie, meta: `${fakty.przestrzenie.duze.wnetrze_m2}\u00A0m² + ${fakty.przestrzenie.duze.taras_m2}\u00A0m² tarasu`, price: `${etykiety.od} ${zloty(fakty.przestrzenie.duze.cena_od)}`, note: card.duze.dopisek.replace("{kiedy}", kiedy), rows: (fakty.uklady?.duze || []).map((row) => ({
      name: row.nazwa, lato: summer(row.lato), zima: winter(row.zima), })), }, {
    id: "male", title: card.male.tytul, href: card.male.href, photo: card.male.zdjecie, meta: `${fakty.przestrzenie.male.wnetrze_m2}\u00A0m² + ${fakty.przestrzenie.male.taras_m2}\u00A0m² tarasu`, price: `${etykiety.od} ${zloty(fakty.przestrzenie.male.cena_od)}`, note: card.male.dopisek, rows: (fakty.uklady?.male || []).map((row) => ({ name: row.nazwa, lato: summer(row.lato), zima: winter(row.zima) })), }, {
    id: "ogrod", title: card.ogrod.tytul, href: card.ogrod.href, photo: card.ogrod.zdjecie, meta: `${fakty.przestrzenie.ogrod.powierzchnia_m2}\u00A0m² · ${fakty.przestrzenie.ogrod.sezon}`, price: etykiety.wycena_indywidualna, note: card.ogrod.dopisek, rows: (fakty.uklady?.ogrod || []).map((row) => ({ name: row.nazwa, lato: summer(row.lato), zima: winter(row.zima) })), }, {
    id: "cale", title: card.cale.tytul, href: card.cale.href, photo: card.cale.zdjecie, meta: card.cale.meta, price: etykiety.wycena_indywidualna, note: card.cale.dopisek.replace("{kiedy}", kiedy), rows: (fakty.uklady?.cale || []).map((row) => ({ name: row.nazwa, lato: summer(row.lato), zima: winter(row.zima) })), }, ];
const endpoint = kontakt.formularz_endpoint || "";
const netlify = !endpoint && kontakt.formularz_netlify !== false;
---

<Base
  title={strona.tytul_seo}
  description={strona.opis_seo}
  image={slides[0].src}
  jsonLd={[venueJsonLd(kontakt, strona.opis_seo, fakty)]}
  preload={true}
  preloadSrcset={heroReady ? heroSrcset("avif") : undefined}
  preloadType={heroReady ? "image/avif" : undefined}
>
  <section class="r12-hero">
    <div class="r12-hero-media">
      {tryb === "wideo" && strona.hero_wideo ? (
        <video src={strona.hero_wideo} poster={slides[0].src} autoplay muted loop playsinline></video>
      ) : tryb === "slider" ? (
        slides.map((slide, index) =>
          index === 0 && heroReady ? (
            <picture class:list={["r12-slide", "is-on"]}>
              <source type="image/avif" srcset={heroSrcset("avif")} sizes="100vw" />
              <source type="image/webp" srcset={heroSrcset("webp")} sizes="100vw" />
              <img src={slide.src} srcset={heroSrcset("jpg")} sizes="100vw" alt={slide.alt} width="1600" height="1066" fetchpriority="high" />
            </picture>
          ) : (
            <img class:list={["r12-slide", index === 0 && "is-on"]} src={slide.src} alt={slide.alt} width="1600" height="1066" />
          ), )
      ) : heroReady ? (
        <picture>
          <source type="image/avif" srcset={heroSrcset("avif")} sizes="100vw" />
          <source type="image/webp" srcset={heroSrcset("webp")} sizes="100vw" />
          <img src={slides[0].src} srcset={heroSrcset("jpg")} sizes="100vw" alt={slides[0].alt} width="1600" height="1066" fetchpriority="high" />
        </picture>
      ) : (
        <img src={slides[0].src} alt={slides[0].alt} width="1600" height="1066" fetchpriority="high" />
      )}
    </div>
    <div class="wrap r12-hero-copy">
      <p class="eyebrow">{strona.hero_kicker}</p>
      <h1>{strona.hero_h1}</h1>
      <p class="lead">{strona.hero_lead}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/kontakt/">{home.hero_cta}</a>
        <a class="btn btn-ghost" href="/przestrzenie/">{home.hero_drugi}</a>
      </div>
    </div>
  </section>

  <section class="band band-white">
    <ul class="r12-usp wrap">
      {home.atuty.map((item) => (
        <li><Icon name={item.ikona} /><span><b>{item.tytul}</b><small>{item.opis}</small></span></li>
      ))}
    </ul>
  </section>

  <section class="band" id="wydarzenia">
    <div class="wrap">
      <p class="eyebrow">{home.wydarzenia_brew}</p>
      <h2>{home.wydarzenia_h}</h2>
      <div class="event-row">
        {kategorie.map((item, index) => (
          <a
            class:list={["event-tile", index === 0 && "is-wide"]}
            style={`--event-color:${item.data.kolor};--event-on:${item.data.kolor_tekst}`}
            href={`/eventy/${item.id}/`}
          >
            <img src={item.data.cover} alt="" width="1600" height="1100" />
            <span class="idx">0{index + 1}</span>
            <span class="vlab">{item.data.nav_label}</span>
            <span class="body">
              <h3>{item.data.title}</h3>
              <p>{item.data.lead}</p>
              <span class="btn">{item.data.cta}</span>
              <span class="tile-go" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-sand" id="przestrzenie">
    <div class="wrap">
      <p class="eyebrow">{home.przestrzenie_brew}</p>
      <h2>{home.przestrzenie_h}</h2>
      <p class="lead">{home.przestrzenie_lead}</p>
      <div class="r12-spaces" data-spaces>
        <div class="r12-space-tabs" role="tablist">
          {spaces.map((space, index) => (
            <button type="button" data-space={space.id} aria-selected={index === 0 ? "true" : "false"}>{space.title}</button>
          ))}
        </div>
        {spaces.map((space, index) => (
          <article class="r12-panel" data-panel={space.id} hidden={index !== 0}>
            <img src={space.photo} alt="" width="1600" height="1000" />
            <div class="r12-panel-body">
              <h3>{space.title}</h3>
              <p class="r12-meta">{space.meta}</p>
              <p class="r12-price">{space.price} <small>{home.serwisy}</small></p>
              <div class="r12-layouts" role="tablist" aria-label="Układ stołów">
                {space.rows.map((row, rowIndex) => (
                  <button type="button" data-layout={rowIndex} aria-selected={rowIndex === 0 ? "true" : "false"}>{row.name}</button>
                ))}
              </div>
              {space.rows.map((row, rowIndex) => (
                <div class="r12-cap" data-cap={rowIndex} hidden={rowIndex !== 0}>
                  <p class="cap-stat"><Icon name="sun" /><span><small>{etykiety.lato}</small><b>{row.lato}</b></span></p>
                  <p class="cap-stat"><Icon name="rain" /><span><small>{etykiety.zima_deszcz}</small><b>{row.zima}</b></span></p>
                </div>
              ))}
              <p class="cap-note">{space.note}</p>
              <a class="btn btn-primary" href={space.href}>{etykiety.zobacz} {space.title}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-white">
    <div class="wrap r12-split">
      <img src={home.jedzenie_zdjecie} alt={home.jedzenie_alt} width="1400" height="1000" />
      <div>
        <p class="eyebrow">{home.jedzenie_brew}</p>
        <h2>{strona.jedzenie_h}</h2>
        <p class="lead">{strona.jedzenie_lead}</p>
        <ul class="r12-menu">
          {cennik.catering.map((row) => (
            <li><b>{row.nazwa}</b><span>{row.cena} {row.jednostka}</span></li>
          ))}
        </ul>
        <a class="btn btn-ghost" href="/jedzenie-i-bar/">{home.jedzenie_link}</a>
      </div>
    </div>
  </section>

  <section class="band band-sand">
    <div class="wrap">
      <p class="eyebrow">{home.inspiracje_brew}</p>
      <h2>{published ? home.inspiracje_h_opublikowane : home.inspiracje_h}</h2>
      <p class="lead">{published ? home.inspiracje_lead_opublikowane : home.inspiracje_lead}</p>
      <div class="r12-cards">
        {inspiracje.map((item) => {
          const tone = toneById[item.data.kategorie?.[0]];
          return (
          <a class="r12-card" style={tone ? `--event-color:${tone.kolor};--event-on:${tone.kolor_tekst}` : undefined} href={published ? `/realizacje/${item.id}/` : `/scenariusze/${item.id}/`}>
            <img src={item.data.cover} alt="" width="1200" height="800" />
            <span class="r12-card-body">
              <span class="event-tag"><Icon name={inspirationIcon[item.data.typ_budzetu] || "tag"} />{published ? item.data.typ : home.inspiracja}</span>
              <h3>{item.data.title}</h3>
              <span class="r12-card-note">{item.data.lead}</span>
              <span class="go">{etykiety.zobacz} <Icon name="arrow" /></span>
            </span>
          </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="band band-white" id="zaplanuj">
    <div class="wrap r12-plan">
      <div>
        <p class="eyebrow">{home.zaplanuj_brew}</p>
        <h2>{home.zaplanuj_h}</h2>
        <p class="lead">{home.zaplanuj_lead}</p>
        <ul class="r12-menu">
          {cennik.wynajem.map((row) => (
            <li>
              <b>{row.dopisek}</b>
              <span>{row.cena_od ? `${etykiety.od} ${zloty(row.cena_od)}` : etykiety.wycena_indywidualna}</span>
            </li>
          ))}
        </ul>
        <a class="btn btn-primary" href="/ceny/#budzet">{home.zaplanuj_cta}</a>
      </div>
      <form class="r12-quick" name="szybki" method="POST" action={endpoint || "/dziekujemy/"} data-netlify={netlify ? "true" : undefined}>
        {netlify && <input type="hidden" name="form-name" value="szybki" />}
        <p class="eyebrow">{form.szybie}</p>
        <label>{form.imie} <input name="imie" required autocomplete="given-name" /></label>
        <label>{form.email} <input name="email" type="email" required autocomplete="email" /></label>
        <label>{form.telefon} <input name="telefon" type="tel" autocomplete="tel" /></label>
        <label>{form.termin} <input name="data" type="text" placeholder={form.placeholder_termin} /></label>
        <label>{form.osoby} <input name="osoby" type="number" inputmode="numeric" min="1" /></label>
        <button class="btn btn-primary" type="submit">{form.wyslij}</button>
        <a class="text-link" href="/kontakt/#brief">{form.wiecej}</a>
      </form>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll("[data-spaces]").forEach((root) => {
    const show = (id) => {
      root.querySelectorAll("[data-space]").forEach((button) => {
        button.setAttribute("aria-selected", button.getAttribute("data-space") === id ? "true" : "false");
      });
      root.querySelectorAll("[data-panel]").forEach((panel) => {
        panel.hidden = panel.getAttribute("data-panel") !== id;
      });
    };
    root.querySelectorAll("[data-space]").forEach((button) => {
      button.addEventListener("click", () => show(button.getAttribute("data-space")));
    });
    root.querySelectorAll("[data-panel]").forEach((panel) => {
      panel.querySelectorAll("[data-layout]").forEach((button) => {
        button.addEventListener("click", () => {
          const index = button.getAttribute("data-layout");
          panel.querySelectorAll("[data-layout]").forEach((peer) => {
            peer.setAttribute("aria-selected", peer === button ? "true" : "false");
          });
          panel.querySelectorAll("[data-cap]").forEach((block) => {
            block.hidden = block.getAttribute("data-cap") !== index;
          });
        });
      });
    });
  });
</script>
