---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import NextBand from "../../components/NextBand.astro";
import { podstrony, crumb } from "../../lib/copy.js";
import { crumbsJsonLd } from "../../lib/nav.js";

const page = podstrony.poradnik;

export async function getStaticPaths() {
  const entries = await getCollection("artykuly");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const crumbs = [
  { href: "/poradnik/", label: crumb("/poradnik/") }, { label: entry.data.title }, ];
const articleLd = {
  "@context": "https://schema.org", "@type": "Article", headline: entry.data.title, description: entry.data.opis_seo, mainEntityOfPage: `https://miejsce.to/poradnik/${entry.id}/`, author: { "@type": "Organization", name: "MIEJSCE" }, publisher: { "@type": "Organization", name: "MIEJSCE" }, };
---

<Base
  title={entry.data.seo_title || `${entry.data.title.replace(/\?$/, "")} | MIEJSCE`}
  description={entry.data.opis_seo}
  robots={entry.data.szkic ? "noindex,follow" : "index,follow"}
  jsonLd={[
    crumbsJsonLd([{ href: "/", label: crumb("/") }, { href: "/poradnik/", label: crumb("/poradnik/") }, { href: `/poradnik/${entry.id}/`, label: entry.data.title }]), ...(entry.data.szkic ? [] : [articleLd]), ]}
>
  <PageHero
    crumbs={crumbs}
    kicker={page.kicker_artykul}
    title={entry.data.title}
    lede={entry.data.opis}
    image={page.zdjecie_artykul}
    imageAlt=""
  />
  <section class="band tight-top">
    <div class="wrap">
      {entry.data.szkic ? <p class="btn-row"><a class="btn btn-primary" href="/kontakt/">{page.pusty}</a></p> : <div class="prose"><Content /></div>}
    </div>
  </section>
  <NextBand
    title={page.nastepny_artykul}
    links={[
      { href: "/poradnik/", label: page.link_tematy }, { href: "/ceny/#estymator", label: page.link_budzet }, { href: "/kontakt/", label: page.cta }, ]}
  />
</Base>
