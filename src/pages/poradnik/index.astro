---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import NextBand from "../../components/NextBand.astro";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

const ustawienia = (await getEntry("ustawienia", "poradnik"))!.data;
const artykuly = sortByOrder(await getCollection("artykuly"));
const crumbs = [{ href: "/poradnik/", label: "Poradnik" }];
---

<Base
  title="Poradnik organizatora | MIEJSCE"
  description={ustawienia.opis_seo}
  image="/img/gallery/mm12.jpg"
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, ...crumbs])]}
>
  <PageHero
    crumbs={crumbs}
    kicker="Wiedza z praktyki"
    title={ustawienia.naglowek}
    lede={ustawienia.lead}
    image="/img/gallery/mm12.jpg"
    imageAlt="Sala nad wodą"
  />
  <section class="band tight-top">
    <div class="wrap stack">
      <p class="lead">{ustawienia.wstep}</p>
      {artykuly.some((article) => !article.data.szkic) ? (
        <ol class="queue">
          {artykuly.filter((article) => !article.data.szkic).map((article, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <a href={`/poradnik/${article.id}/`}>{article.data.title}</a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="btn-row"><a class="btn btn-primary" href="/kontakt/">Zapytaj o event</a></p>
      )}
    </div>
  </section>
  <NextBand
    title="Wolisz policzyć niż czytać?"
    links={[
      { href: "/ceny/#estymator", label: "Sprawdź budżet" },
      { href: "/eventy/", label: "Rodzaje wydarzeń" },
      { href: "/kontakt/", label: "Zaplanuj event" },
    ]}
  />
</Base>
