---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import NextBand from "../../components/NextBand.astro";
import { podstrony, crumb } from "../../lib/copy.js";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

const page = podstrony.poradnik;

const ustawienia = (await getEntry("ustawienia", "poradnik"))!.data;
const artykuly = sortByOrder(await getCollection("artykuly"));
const crumbs = [{ href: "/poradnik/", label: crumb("/poradnik/") }];
---

<Base
  title={page.tytul}
  description={ustawienia.opis_seo}
  image={page.zdjecie}
  jsonLd={[crumbsJsonLd([{ href: "/", label: crumb("/") }, ...crumbs])]}
>
  <PageHero
    crumbs={crumbs}
    kicker={page.kicker}
    title={ustawienia.naglowek}
    lede={ustawienia.lead}
    image={page.zdjecie}
    imageAlt={page.alt}
  />
  <section class="band tight-top">
    <div class="wrap stack">
      <p class="lead">{ustawienia.wstep}</p>
      {artykuly.some((article) => !article.data.szkic) ? (
        <ol class="queue">
          {artykuly.filter((article) => !article.data.szkic).map((article, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <a href={`/poradnik/${article.id}/`}>{article.data.title}</a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="btn-row"><a class="btn btn-primary" href="/kontakt/">{page.pusty}</a></p>
      )}
    </div>
  </section>
  <NextBand
    title={page.nastepny}
    links={[
      { href: "/ceny/#estymator", label: page.link_budzet }, { href: "/eventy/", label: page.link }, { href: "/kontakt/", label: page.cta }, ]}
  />
</Base>
