---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import NextBand from "../../components/NextBand.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { etykiety, podstrony, crumb } from "../../lib/copy.js";
import { crumbsJsonLd } from "../../lib/nav.js";

const page = podstrony.realizacje;

export async function getStaticPaths() {
  const entries = await getCollection("realizacje");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const crumbs = [
  { href: "/realizacje/", label: crumb("/realizacje/") }, { label: entry.data.title }, ];
const articleLd = entry.data.szkic
  ? null
  : {
      "@context": "https://schema.org", "@type": "Article", headline: entry.data.title, description: entry.data.opis_seo, image: new URL(entry.data.cover, "https://miejsce.to").href, mainEntityOfPage: `https://miejsce.to/realizacje/${entry.id}/`, author: { "@type": "Organization", name: "MIEJSCE" }, publisher: { "@type": "Organization", name: "MIEJSCE" }, };
---

<Base
  title={page.tytul_wpis.replace("{tytul}", entry.data.title)}
  description={entry.data.szkic ? page.opis_szkic.replace("{tytul}", entry.data.title) : entry.data.opis_seo}
  image={entry.data.cover}
  robots={entry.data.szkic ? "noindex,follow" : "index,follow"}
  jsonLd={[
    crumbsJsonLd([{ href: "/", label: crumb("/") }, { href: "/realizacje/", label: crumb("/realizacje/") }, { href: `/realizacje/${entry.id}/`, label: entry.data.title }]), ...(articleLd ? [articleLd] : []), ]}
>
  <PageHero
    crumbs={crumbs}
    kicker={entry.data.typ}
    title={entry.data.title}
    lede={entry.data.szkic ? entry.data.typ : entry.data.lead}
    image={entry.data.cover}
    imageAlt={entry.data.title}
  />
  <section class="band">
    <div class="wrap split">
      <div class="stack">
        {entry.data.meta && !/uzupełn/i.test(entry.data.meta) && <p class="meta">{entry.data.meta}</p>}
        {!entry.data.szkic && <div class="prose"><Content /></div>}
        {entry.data.szkic && <p class="btn-row"><a class="btn btn-primary" href="/kontakt/">{page.podobny}</a></p>}
      </div>
      <dl class="sheet">
        <div><dt>{page.przestrzenie}</dt><dd>{entry.data.przestrzenie}</dd></div>
        <div><dt>{page.jedzenie}</dt><dd>{entry.data.jedzenie}</dd></div>
        <div><dt>{page.bar}</dt><dd>{entry.data.bar}</dd></div>
        <div><dt>{page.atrakcje}</dt><dd>{entry.data.atrakcje}</dd></div>
      </dl>
    </div>
  </section>
  <section class="band band-dark">
    <div class="wrap stack-lg">
      <SectionHeader eyebrow={page.brew_zdjecia} title={page.klatki} />
      <div class="gallery-row">
        {entry.data.zdjecia.slice(0, 3).map((src, index) => <img src={src} alt={`${entry.data.title}, ${page.zdjecie} ${index + 1}`} />)}
      </div>
    </div>
  </section>
  <NextBand
    kicker={etykiety.nastepny_krok}
    title={page.pytanie}
    links={[
      { href: "/realizacje/", label: page.wszystkie }, { href: "/ceny/", label: page.ceny }, { href: "/eventy/", label: page.scenariusze }, ]}
    cta={page.cta}
  />
</Base>
