---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Gallery from "../../components/Gallery.astro";
import NextBand from "../../components/NextBand.astro";
import { etykiety, podstrony, crumb } from "../../lib/copy.js";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

const page = podstrony.realizacje;

const realizacje = sortByOrder(await getCollection("realizacje")).filter((item) => !item.data.szkic);
const galeria = (await getEntry("ustawienia", "galeria"))!.data;
const featured = realizacje[0];
const crumbs = [{ href: "/realizacje/", label: crumb("/realizacje/") }];
---

<Base
  title={page.tytul}
  description={page.opis}
  jsonLd={[crumbsJsonLd([{ href: "/", label: crumb("/") }, ...crumbs])]}
>
  <PageHero
    crumbs={crumbs}
    kicker={featured ? featured.data.typ : page.wkrotce}
    title={page.h}
    lede={featured ? page.lead_tak : page.lead_nie}
    image={featured?.data.cover || page.zdjecie_puste}
    imageAlt={featured?.data.title || page.alt_pusty}
  />

  {featured && <section class="band">
    <div class="wrap">
      <article class="feature">
        <a class="feature-media" href={`/realizacje/${featured.id}/`}>
          <img src={featured.data.cover} alt={featured.data.title} />
        </a>
        <div class="feature-copy">
          <p class="eyebrow">{featured.data.typ}</p>
          <h2>{featured.data.title}</h2>
          {featured.data.lead && !/uzupełn|szkic/i.test(featured.data.lead) && <p class="lead">{featured.data.lead}</p>}
          {featured.data.meta && !/uzupełn/i.test(featured.data.meta) && <p class="meta">{featured.data.meta}</p>}
          <a class="btn btn-primary" href={`/realizacje/${featured.id}/`}>{page.zobacz}</a>
        </div>
      </article>
    </div>
  </section>}

  <section class="band band-surface">
    <div class="wrap">
      <div class="cards-3">
        {
          realizacje.map((item) => (
            <article class="media-card">
              <a href={`/realizacje/${item.id}/`}>
                <img src={item.data.cover} alt="" />
                <div class="card-body">
                  <p class="eyebrow">{item.data.typ}</p>
                  <h3>{item.data.title}</h3>
                  {item.data.lead && !/uzupełn|szkic/i.test(item.data.lead) ? <p>{item.data.lead}</p> : null}
                  <span class="btn btn-ghost">{page.otworz}</span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Gallery galeria={galeria} limit={9} />
  <NextBand
    kicker={etykiety.nastepny_krok}
    title={page.nastepny}
    links={[
      { href: "/galeria/", label: page.galeria }, { href: "/eventy/", label: page.scenariusze }, { href: "/ceny/", label: page.ceny }, ]}
    cta={page.cta}
  />
</Base>
