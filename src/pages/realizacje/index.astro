---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Gallery from "../../components/Gallery.astro";
import NextBand from "../../components/NextBand.astro";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

const realizacje = sortByOrder(await getCollection("realizacje"));
const galeria = (await getEntry("ustawienia", "galeria"))!.data;
const crumbs = [{ href: "/realizacje/", label: "Realizacje" }];
---

<Base
  title="Realizacje | MIEJSCE"
  description="Wybrane wydarzenia w MIEJSCU. Opisy oznaczone jako szkic czekają na uzupełnienie — bez dopisanych liczb."
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, ...crumbs])]}
>
  <PageHero
    crumbs={crumbs}
    kicker="Z wody, nie z katalogu"
    title="Realizacje"
    lede="Zamiast samej galerii: co to było, w której przestrzeni i co jeszcze trzeba dopisać. Na start trzy szkice z nazw, które już są na obecnej stronie."
    image="/img/gallery/ws01.jpg"
    imageAlt="Przyjęcie na barce"
  />
  <section class="sec sec-tint" style="padding-top:28px">
    <div class="wrap">
      <ul class="case-row">
        {
          realizacje.map((item, index) => (
            <li>
              <a href={`/realizacje/${item.id}/`}>
                <figure class:list={["print", index % 2 ? "tilt-r" : "tilt-l", "land"]}>
                  <img src={item.data.cover} alt="" loading="lazy" />
                </figure>
                {item.data.szkic && <p class="badge">Szkic</p>}
                <h3>{item.data.title}</h3>
                <p>{item.data.meta}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <Gallery galeria={galeria} limit={9} />
  <NextBand
    kicker="Następny krok"
    title="Zróbmy podobny wieczór"
    links={[
      { href: "/galeria/", label: "Cała galeria" },
      { href: "/eventy/", label: "Scenariusze" },
      { href: "/ceny/", label: "Ceny" },
    ]}
    cta="Zapytaj o termin"
  />
</Base>
