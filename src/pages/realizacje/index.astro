---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Gallery from "../../components/Gallery.astro";
import NextBand from "../../components/NextBand.astro";
import { crumbsJsonLd, sortByOrder } from "../../lib/nav.js";

const realizacje = sortByOrder(await getCollection("realizacje"));
const galeria = (await getEntry("ustawienia", "galeria"))!.data;
const featured = realizacje[0];
const crumbs = [{ href: "/realizacje/", label: "Realizacje" }];
---

<Base
  title="Realizacje | MIEJSCE"
  description="Wybrane wydarzenia w MIEJSCU. Opisy oznaczone jako szkic czekają na uzupełnienie — bez dopisanych liczb."
  jsonLd={[crumbsJsonLd([{ href: "/", label: "MIEJSCE" }, ...crumbs])]}
>
  <PageHero
    crumbs={crumbs}
    kicker={featured.data.typ}
    title="Realizacje"
    lede="Najpierw jedna historia, potem siatka. Liczby gości zostają puste, dopóki nie ma ich w materiale."
    image={featured.data.cover}
    imageAlt={featured.data.title}
  />

  <section class="band">
    <div class="wrap">
      <article class="feature">
        <a class="feature-media" href={`/realizacje/${featured.id}/`}>
          <img src={featured.data.cover} alt={featured.data.title} />
        </a>
        <div class="feature-copy">
          {featured.data.szkic && <p class="badge">Szkic</p>}
          <p class="eyebrow">{featured.data.typ}</p>
          <h2>{featured.data.title}</h2>
          <p class="lead">{featured.data.lead}</p>
          <p class="meta">{featured.data.meta}</p>
          <p class="meta">Goście: do uzupełnienia</p>
          <a class="btn btn-primary" href={`/realizacje/${featured.id}/`}>Zobacz realizację</a>
        </div>
      </article>
    </div>
  </section>

  <section class="band band-surface">
    <div class="wrap">
      <div class="cards-3">
        {
          realizacje.map((item) => (
            <article class="media-card">
              <a href={`/realizacje/${item.id}/`}>
                <img src={item.data.cover} alt="" />
                <div class="card-body">
                  <p class="eyebrow">{item.data.typ}</p>
                  <h3>{item.data.title}</h3>
                  <p>{item.data.lead}</p>
                  <p class="meta">{item.data.meta}</p>
                  <p class="meta">Goście: do uzupełnienia</p>
                  <span class="btn btn-ghost">Otwórz</span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Gallery galeria={galeria} limit={9} />
  <NextBand
    kicker="Następny krok"
    title="Zróbmy podobny wieczór"
    links={[
      { href: "/galeria/", label: "Cała galeria" },
      { href: "/eventy/", label: "Scenariusze" },
      { href: "/ceny/", label: "Ceny" },
    ]}
    cta="Zapytaj o termin"
  />
</Base>
