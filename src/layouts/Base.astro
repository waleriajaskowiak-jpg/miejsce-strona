---
import "@fontsource/bebas-neue/latin-ext-400.css";
import "@fontsource/inter/latin-ext-400.css";
import "@fontsource/inter/latin-ext-500.css";
import "@fontsource/inter/latin-ext-600.css";
import "../styles/tokens.css";
import "../styles/system.css";
import "../styles/harbour.css";
import "../styles/mobile.css";
import "../styles/rebrand.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { IS_PROD } from "../lib/env.js";

const {
  title,
  description,
  image = "/img/pdf/hero-main.jpg",
  robots = "index,follow",
  jsonLd = [],
  overlay = false,
  ogType = "website",
  preload = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const absImage = new URL(image, Astro.site).href;
const robotsFinal = IS_PROD ? robots : "noindex,nofollow";
const jsonBlocks = jsonLd.map((obj) => JSON.stringify(obj).replace(/</g, "\\u003c"));
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="robots" content={robotsFinal} />
    {preload && <link rel="preload" as="image" href={image} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="MIEJSCE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={absImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absImage} />
    {jsonBlocks.map((block) => <script type="application/ld+json" set:html={block} />)}
    <script is:inline>
      document.documentElement.classList.add("js");
      if (!/(^|\.)miejsce\.to$/.test(location.hostname)) {
        const robots = document.querySelector('meta[name="robots"]');
        if (robots) robots.content = "noindex,nofollow";
      }
    </script>
  </head>
  <body class:list={[overlay && "has-overlay"]}>
    <a class="skip" href="#main">Przejdź do treści</a>
    <Header />
    <div class="page-scroll">
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <a class="mob-cta btn btn-primary" href="/kontakt/" hidden>Zaplanuj event</a>
    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const nodes = document.querySelectorAll(".reveal");
      if (reduce) {
        nodes.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        nodes.forEach((el) => io.observe(el));
      }

      const root = document.querySelector("main");
      const skip = new Set(["SCRIPT", "STYLE", "TEXTAREA", "INPUT", "SELECT"]);
      const glue = (node) => {
        if (node.nodeType === 3 && node.nodeValue) {
          node.nodeValue = node.nodeValue.replace(/(^|\s)([aiouwzAIOUWZ])\s+/g, "$1$2\u00A0");
          return;
        }
        if (node.nodeType === 1 && !skip.has(node.nodeName)) {
          node.childNodes.forEach(glue);
        }
      };
      if (root) glue(root);

      const head = document.querySelector(".site-head");
      const bar = document.querySelector(".mob-cta");
      const scroller = document.querySelector(".page-scroll");
      const onKontakt = location.pathname.startsWith("/kontakt");
      const scrollY = () => scroller?.scrollTop || window.scrollY;
      const onScroll = () => {
        head?.classList.toggle("is-stuck", scrollY() > 40);
        if (!bar) return;
        const drawer = document.body.classList.contains("nav-open");
        const ctaInView = [...document.querySelectorAll('a[href^="/kontakt/"]')].some((link) => {
          if (link === bar) return false;
          const box = link.getBoundingClientRect();
          return box.bottom > 80 && box.top < window.innerHeight - 80;
        });
        const foot = document.querySelector(".site-foot");
        const footNear = foot ? foot.getBoundingClientRect().top < window.innerHeight - 24 : false;
        const formNear = [...document.querySelectorAll("form, .form-panel")].some((el) => {
          const box = el.getBoundingClientRect();
          return box.top < window.innerHeight - 80 && box.bottom > 120;
        });
        const phone = window.matchMedia("(max-width: 800px)").matches;
        const show = phone && !onKontakt && !drawer && !ctaInView && !footNear && !formNear && scrollY() > 280;
        bar.hidden = !show;
        bar.classList.remove("is-quiet");
        document.body.classList.toggle("has-bar", show);
        bar.setAttribute("aria-hidden", show ? "false" : "true");
        bar.tabIndex = show ? 0 : -1;
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
      scroller?.addEventListener("scroll", onScroll, { passive: true });
      document.addEventListener("miejsce:nav", onScroll);

      document.querySelectorAll("[data-snap]").forEach((scroller) => {
        const dots = scroller.parentElement?.querySelector("[data-snapdots]");
        if (!dots) return;
        const items = [...scroller.children];
        dots.innerHTML = items.map((_, index) => `<i class="${index === 0 ? "is-on" : ""}"></i>`).join("");
        const markSnap = () => {
          const edge = scroller.getBoundingClientRect().left;
          let best = 0;
          let bestDist = Infinity;
          items.forEach((item, index) => {
            const dist = Math.abs(item.getBoundingClientRect().left - edge);
            if (dist < bestDist) {
              bestDist = dist;
              best = index;
            }
          });
          dots.querySelectorAll("i").forEach((dot, index) => dot.classList.toggle("is-on", index === best));
        };
        scroller.addEventListener("scroll", markSnap, { passive: true });
        markSnap();
      });
    </script>
    <script>
      import "../scripts/motion.js";
    </script>
  </body>
</html>
