---
import { getCollection } from "astro:content";
import { NAV } from "../lib/nav.js";
import { sortByOrder } from "../lib/nav.js";

const path = Astro.url.pathname;
const current = (href) => path === href || (href !== "/" && path.startsWith(href));
const kategorie = sortByOrder(await getCollection("kategorie"));
---

<header class="site-head">
  <div class="wrap head-inner">
    <a class="brand" href="/" aria-label="MIEJSCE, strona główna">
      <img src="/img/wordmark.png" alt="MIEJSCE" width="900" height="258" />
    </a>
    <nav class="nav-desk" aria-label="Główna">
      <div class="nav-drop">
        <a href="/eventy/" aria-current={current("/eventy/") ? "page" : undefined}>Wydarzenia</a>
        <div class="nav-sub">
          {kategorie.map((item) => (
            <a href={`/eventy/${item.id}/`}>{item.data.nav_label}</a>
          ))}
          <a href="/scenariusze/">Scenariusze</a>
        </div>
      </div>
      {
        NAV.filter((item) => item.href !== "/eventy/").map((item) => (
          <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <a class="btn btn-primary btn-sm head-cta" href="/kontakt/">Zaplanuj event</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-panel">
      Menu
    </button>
  </div>
</header>
<div class="nav-panel" id="nav-panel" hidden>
  <nav aria-label="Mobilna">
    <p class="drawer-label">Co planujesz?</p>
    {kategorie.map((item) => (
      <a class="drawer-cat" href={`/eventy/${item.id}/`}>{item.data.nav_label}</a>
    ))}
    <a href="/przestrzenie/">Przestrzenie</a>
    <a href="/ceny/">Ceny i budżet</a>
    <a href="/realizacje/">Realizacje</a>
    <a href="/jedzenie-i-bar/">Jedzenie i bar</a>
    <a href="/poradnik/">Poradnik</a>
    <a href="/warto-wiedziec/">Warto wiedzieć</a>
    <a href="/scenariusze/">Scenariusze</a>
    <a href="/kontakt/">Zaplanuj event</a>
    <a href="/kontakt/?cel=ogledziny">Umów oględziny</a>
  </nav>
</div>
<script>
  const btn = document.querySelector(".nav-toggle");
  const panel = document.querySelector(".nav-panel");
  const setOpen = (open) => {
    if (!panel || !btn) return;
    panel.hidden = !open;
    btn.setAttribute("aria-expanded", open ? "true" : "false");
    btn.textContent = open ? "Zamknij" : "Menu";
    document.body.classList.toggle("nav-open", open);
    document.dispatchEvent(new Event("miejsce:nav"));
    if (open) panel.querySelector("a")?.focus();
  };
  btn?.addEventListener("click", () => setOpen(Boolean(panel?.hidden)));
  panel?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
</script>
