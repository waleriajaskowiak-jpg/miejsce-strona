---
import { getCollection, getEntry } from "astro:content";
import Icon from "./Icon.astro";
import { sortByOrder } from "../lib/nav.js";

const path = Astro.url.pathname;
const current = (href: string) => path === href || (href !== "/" && path.startsWith(href));
const kategorie = sortByOrder(await getCollection("kategorie"));
const przestrzenie = sortByOrder(await getCollection("przestrzenie"));
const kontakt = (await getEntry("ustawienia", "kontakt"))?.data;
const shortSpace = {
  "duze-miejsce": "Duże",
  "nowe-miejsce": "Małe",
  ogrod: "Ogród",
  "cale-miejsce": "Całe",
};
const mains = [
  { href: "/ceny/", label: "Ceny", n: "01" },
  { href: "/realizacje/", label: "Realizacje", n: "02" },
  { href: "/kontakt/", label: "Kontakt", n: "03" },
];
---

<header class="site-head">
  <div class="wrap head-inner">
    <a class="brand" href="/" aria-label="MIEJSCE, strona główna">
      <img class="logo-day" src="/img/logo-grafit.svg" alt="MIEJSCE" width="1550" height="444" />
      <img class="logo-night" src="/img/logo-ecru.svg" alt="" width="1550" height="444" />
    </a>
    <nav class="nav-desk" aria-label="Główna">
      <div class="nav-dd">
        <a href="/eventy/" aria-expanded="false" aria-controls="menu-wydarzenia" aria-current={current("/eventy/") ? "page" : undefined}>
          Wydarzenia <i class="chev" aria-hidden="true"></i>
        </a>
        <div class="nav-pop" id="menu-wydarzenia">
          {kategorie.map((item) => (
            <a href={`/eventy/${item.id}/`} style={`--event-color:${item.data.kolor};--event-on:${item.data.kolor_tekst}`}><i class="event-dot" aria-hidden="true"></i>{item.data.nav_label}</a>
          ))}
        </div>
      </div>
      <div class="nav-dd">
        <a href="/przestrzenie/" aria-expanded="false" aria-controls="menu-przestrzenie" aria-current={current("/przestrzenie/") ? "page" : undefined}>
          Przestrzenie <i class="chev" aria-hidden="true"></i>
        </a>
        <div class="nav-pop" id="menu-przestrzenie">
          {przestrzenie.map((item) => (
            <a href={`/przestrzenie/${item.id}/`}>{item.data.title}</a>
          ))}
        </div>
      </div>
      <a href="/ceny/" aria-current={current("/ceny/") ? "page" : undefined}>Ceny</a>
      <a href="/realizacje/" aria-current={current("/realizacje/") ? "page" : undefined}>Realizacje</a>
      <a href="/kontakt/" aria-current={current("/kontakt/") ? "page" : undefined}>Kontakt</a>
    </nav>
    <a class="btn btn-primary btn-sm head-plan" href="/kontakt/">Zaplanuj wydarzenie</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Menu">
      <span class="burger" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="nav-panel" id="nav-panel" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true">
  <nav aria-label="Mobilna">
    <p class="menu-kicker rise" style="--d:0">Wydarzenia</p>
    <div class="menu-cats">
      {kategorie.map((item, index) => (
        <a class:list={["menu-cat", "rise"]} style={`--d:${3 + index};--event-color:${item.data.kolor};--event-on:${item.data.kolor_tekst}`} href={`/eventy/${item.id}/`}>
          <i></i>
          <span>{item.data.nav_label}</span>
          <Icon name="arrow" />
        </a>
      ))}
    </div>
    <p class="menu-kicker rise" style="--d:7">Przestrzenie</p>
    <div class="menu-spaces rise" style="--d:8">
      {przestrzenie.map((space) => (
        <a class="menu-space" href={`/przestrzenie/${space.id}/`}>
          <img src={space.data.cover} alt="" />
          <span>{shortSpace[space.id] || space.data.title}</span>
        </a>
      ))}
    </div>
    <div class="menu-mains">
      {mains.map((item, index) => (
        <a class="menu-main rise" style={`--d:${9 + index}`} href={item.href} aria-current={current(item.href) ? "page" : undefined}>
          <em>{item.n}</em>
          <span>{item.label}</span>
          <Icon name="arrow" />
        </a>
      ))}
    </div>
    <div class="menu-foot rise" style="--d:12">
      <a class="btn btn-primary" href="/kontakt/">Zaplanuj wydarzenie</a>
      {kontakt && <a class="btn btn-ghost" href={`tel:${kontakt.telefon_href}`}>Zadzwoń</a>}
      <div class="menu-meta">
        {kontakt && <a class="icon-line" href={`tel:${kontakt.telefon_href}`}><Icon name="phone" /><span>{kontakt.telefon_wyswietlany}</span></a>}
        {kontakt && <a class="icon-line" href={`mailto:${kontakt.email}`}><Icon name="mail" /><span>{kontakt.email}</span></a>}
        <a class="icon-line" href="https://instagram.com/miejsceto/" rel="noopener"><Icon name="ig" /><span>Instagram</span></a>
      </div>
    </div>
  </nav>
</div>

<script>
  const btn = document.querySelector(".nav-toggle");
  const panel = document.querySelector(".nav-panel");
  const scroller = document.querySelector(".page-scroll");
  const focusables = () => [btn, ...panel.querySelectorAll("a")].filter(Boolean);
  const setDrawer = (open) => {
    if (!panel || !btn) return;
    const was = document.body.classList.contains("nav-open");
    panel.setAttribute("aria-hidden", open ? "false" : "true");
    btn.setAttribute("aria-expanded", open ? "true" : "false");
    btn.setAttribute("aria-label", open ? "Zamknij menu" : "Menu");
    document.body.classList.toggle("nav-open", open);
    if (scroller) scroller.style.overflow = open ? "hidden" : "";
    document.body.style.overflow = open ? "hidden" : "";
    if (open && !was) panel.querySelector("a")?.focus();
    if (!open && was) btn.focus();
    document.dispatchEvent(new Event("miejsce:nav"));
  };
  btn?.addEventListener("click", () => setDrawer(!document.body.classList.contains("nav-open")));
  panel?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setDrawer(false)));
  document.querySelectorAll(".nav-dd").forEach((dd) => {
    const trigger = dd.querySelector("a");
    const pop = dd.querySelector(".nav-pop");
    dd.addEventListener("mouseenter", () => trigger?.setAttribute("aria-expanded", "true"));
    dd.addEventListener("mouseleave", () => trigger?.setAttribute("aria-expanded", "false"));
    dd.addEventListener("focusin", () => trigger?.setAttribute("aria-expanded", "true"));
    dd.addEventListener("focusout", (event) => {
      if (!dd.contains(event.relatedTarget)) trigger?.setAttribute("aria-expanded", "false");
    });
    pop?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => trigger?.setAttribute("aria-expanded", "false")));
  });
  document.addEventListener("keydown", (event) => {
    if (!document.body.classList.contains("nav-open")) return;
    if (event.key === "Escape") {
      setDrawer(false);
      return;
    }
    if (event.key !== "Tab") return;
    const items = focusables();
    const first = items[0];
    const last = items[items.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
