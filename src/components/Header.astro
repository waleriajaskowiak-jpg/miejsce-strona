---
import { getCollection, getEntry } from "astro:content";
import { sortByOrder } from "../lib/nav.js";

const path = Astro.url.pathname;
const current = (href: string) => path === href || (href !== "/" && path.startsWith(href));
const kategorie = sortByOrder(await getCollection("kategorie"));
const przestrzenie = sortByOrder(await getCollection("przestrzenie"));
const kontakt = (await getEntry("ustawienia", "kontakt"))?.data;
---

<header class="site-head">
  <div class="wrap head-inner">
    <a class="brand" href="/" aria-label="MIEJSCE, strona główna">
      <img src="/img/logo-grafit.svg" alt="MIEJSCE" width="440" height="86" />
    </a>
    <nav class="nav-desk" aria-label="Główna">
      <div class="nav-dd">
        <a href="/eventy/" aria-expanded="false" aria-controls="menu-wydarzenia" aria-current={current("/eventy/") ? "page" : undefined}>
          Wydarzenia <i class="chev" aria-hidden="true"></i>
        </a>
        <div class="nav-pop" id="menu-wydarzenia">
          {kategorie.map((item) => (
            <a href={`/eventy/${item.id}/`}>{item.data.nav_label}</a>
          ))}
        </div>
      </div>
      <div class="nav-dd">
        <a href="/przestrzenie/" aria-expanded="false" aria-controls="menu-przestrzenie" aria-current={current("/przestrzenie/") ? "page" : undefined}>
          Przestrzenie <i class="chev" aria-hidden="true"></i>
        </a>
        <div class="nav-pop" id="menu-przestrzenie">
          {przestrzenie.map((item) => (
            <a href={`/przestrzenie/${item.id}/`}>{item.data.title}</a>
          ))}
        </div>
      </div>
      <a href="/ceny/" aria-current={current("/ceny/") ? "page" : undefined}>Ceny</a>
      <a href="/realizacje/" aria-current={current("/realizacje/") ? "page" : undefined}>Realizacje</a>
      <a href="/kontakt/" aria-current={current("/kontakt/") ? "page" : undefined}>Kontakt</a>
    </nav>
    <a class="btn btn-primary btn-sm head-plan" href="/kontakt/">Zaplanuj wydarzenie</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Menu">
      <span></span>
    </button>
  </div>
</header>

<div class="nav-panel" id="nav-panel" hidden>
  <nav aria-label="Mobilna">
    <p class="drawer-label">Wydarzenia</p>
    {kategorie.map((item) => (
      <a class="drawer-link" href={`/eventy/${item.id}/`} aria-current={path === `/eventy/${item.id}/` ? "page" : undefined}>{item.data.nav_label}</a>
    ))}
    <p class="drawer-label">Przestrzenie</p>
    {przestrzenie.map((item) => (
      <a class="drawer-link" href={`/przestrzenie/${item.id}/`} aria-current={path === `/przestrzenie/${item.id}/` ? "page" : undefined}>{item.data.title}</a>
    ))}
    <a class="drawer-link" href="/ceny/" aria-current={current("/ceny/") ? "page" : undefined}>Ceny</a>
    <a class="drawer-link" href="/realizacje/" aria-current={current("/realizacje/") ? "page" : undefined}>Realizacje</a>
    <a class="drawer-link" href="/kontakt/" aria-current={current("/kontakt/") ? "page" : undefined}>Kontakt</a>
    <a class="drawer-link" href="/scenariusze/">Scenariusze</a>
    <a class="drawer-link" href="/jedzenie-i-bar/">Jedzenie i bar</a>
    <a class="drawer-link" href="/warto-wiedziec/">Warto wiedzieć</a>
    <div class="drawer-cta">
      <a class="btn btn-primary" href="/kontakt/">Zaplanuj wydarzenie</a>
      {kontakt && <a class="btn btn-ghost" href={`tel:${kontakt.telefon_href}`}>Zadzwoń</a>}
    </div>
  </nav>
</div>

<script>
  const btn = document.querySelector(".nav-toggle");
  const panel = document.querySelector(".nav-panel");
  const setDrawer = (open) => {
    if (!panel || !btn) return;
    panel.hidden = !open;
    btn.setAttribute("aria-expanded", open ? "true" : "false");
    document.body.classList.toggle("nav-open", open);
    document.dispatchEvent(new Event("miejsce:nav"));
  };
  btn?.addEventListener("click", () => setDrawer(Boolean(panel?.hidden)));
  panel?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setDrawer(false)));
  document.querySelectorAll(".nav-dd").forEach((dd) => {
    const trigger = dd.querySelector("a");
    const pop = dd.querySelector(".nav-pop");
    dd.addEventListener("mouseenter", () => trigger?.setAttribute("aria-expanded", "true"));
    dd.addEventListener("mouseleave", () => trigger?.setAttribute("aria-expanded", "false"));
    dd.addEventListener("focusin", () => trigger?.setAttribute("aria-expanded", "true"));
    dd.addEventListener("focusout", (event) => {
      if (!dd.contains(event.relatedTarget)) trigger?.setAttribute("aria-expanded", "false");
    });
    pop?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => trigger?.setAttribute("aria-expanded", "false")));
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setDrawer(false);
  });
</script>
