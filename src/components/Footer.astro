---
import { getCollection, getEntry } from "astro:content";
import Icon from "./Icon.astro";
import { stopka } from "../lib/copy.js";
import { sortByOrder } from "../lib/nav.js";

const kontakt = (await getEntry("ustawienia", "kontakt"))?.data;
const kategorie = sortByOrder(await getCollection("kategorie"));
---

<footer class="site-foot">
  <div class="wrap foot-grid">
    <div>
      <a class="brand" href="/" aria-label={stopka.aria_marka}>
        <img src={stopka.logo} alt="" width="440" height="86" />
      </a>
      <p class="icon-line"><Icon name="pin" /><span>{kontakt?.ulica}, {kontakt?.kod} {kontakt?.miasto}</span></p>
      <p class="icon-line"><Icon name="mail" /><a href={`mailto:${kontakt?.email}`}>{kontakt?.email}</a></p>
      <p class="icon-line"><Icon name="phone" /><a href={`tel:${kontakt?.telefon_href}`}>{kontakt?.telefon_wyswietlany}</a></p>
    </div>
    <div>
      <p class="foot-label">{stopka.wydarzenia}</p>
      <ul>
        {kategorie.map((item) => (
          <li><a href={`/eventy/${item.id}/`}>{item.data.nav_label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="foot-label">{stopka.miejsce}</p>
      <ul>
        {stopka.miejsce_linki.map((link) => <li><a href={link.href}>{link.etykieta}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="foot-label">{stopka.plan}</p>
      <ul>
        {stopka.plan_linki.map((link) => <li><a href={link.href}>{link.etykieta}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="foot-label">{stopka.kontakt}</p>
      <ul>
        {stopka.kontakt_linki.map((link) => <li><a href={link.href}>{link.etykieta}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap foot-note">
    <p>{stopka.linia}</p>
  </div>
</footer>
