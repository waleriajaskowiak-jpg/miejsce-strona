---
import { getCollection, getEntry } from "astro:content";
import { FOOTER_PAGES, sortByOrder } from "../lib/nav.js";

const kontakt = (await getEntry("ustawienia", "kontakt"))?.data;
const kategorie = sortByOrder(await getCollection("kategorie"));
---

<footer class="site-foot">
  <div class="wrap foot-grid">
    <div>
      <a class="brand" href="/" aria-label="MIEJSCE">
        <img src="/img/wordmark.png" alt="" width="900" height="258" />
      </a>
      <p>
        {kontakt?.ulica}<br />
        {kontakt?.kod} {kontakt?.miasto}<br />
        {kontakt?.dzielnica}
      </p>
      <p><a href={`mailto:${kontakt?.email}`}>{kontakt?.email}</a></p>
      <p><a href={`tel:${kontakt?.telefon_href}`}>{kontakt?.telefon_wyswietlany}</a></p>
    </div>
    <div>
      <p class="foot-label">Wydarzenia</p>
      <ul>
        {kategorie.map((item) => (
          <li><a href={`/eventy/${item.id}/`}>{item.data.nav_label}</a></li>
        ))}
        <li><a href="/scenariusze/">Scenariusze</a></li>
      </ul>
    </div>
    <div>
      <p class="foot-label">Na stronie</p>
      <ul>
        <li><a href="/przestrzenie/">Przestrzenie</a></li>
        <li><a href="/ceny/">Ceny</a></li>
        <li><a href="/realizacje/">Realizacje</a></li>
        {FOOTER_PAGES.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap foot-note">
    <p>MIEJSCE · eventy nad wodą · Port Czerniakowski · miejsce.to</p>
  </div>
</footer>
