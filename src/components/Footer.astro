---
import { getCollection, getEntry } from "astro:content";
import Icon from "./Icon.astro";
import { sortByOrder } from "../lib/nav.js";

const kontakt = (await getEntry("ustawienia", "kontakt"))?.data;
const kategorie = sortByOrder(await getCollection("kategorie"));
---

<footer class="site-foot">
  <div class="wrap foot-grid">
    <div>
      <a class="brand" href="/" aria-label="MIEJSCE">
        <img src="/img/logo-ecru.svg" alt="" width="440" height="86" />
      </a>
      <p class="icon-line"><Icon name="pin" /><span>{kontakt?.ulica}, {kontakt?.kod} {kontakt?.miasto}</span></p>
      <p class="icon-line"><Icon name="mail" /><a href={`mailto:${kontakt?.email}`}>{kontakt?.email}</a></p>
      <p class="icon-line"><Icon name="phone" /><a href={`tel:${kontakt?.telefon_href}`}>{kontakt?.telefon_wyswietlany}</a></p>
    </div>
    <div>
      <p class="foot-label">Wydarzenia</p>
      <ul>
        {kategorie.map((item) => (
          <li><a href={`/eventy/${item.id}/`}>{item.data.nav_label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="foot-label">Miejsce</p>
      <ul>
        <li><a href="/przestrzenie/">Przestrzenie</a></li>
        <li><a href="/ceny/">Ceny</a></li>
        <li><a href="/realizacje/">Realizacje</a></li>
        <li><a href="/galeria/">Galeria</a></li>
      </ul>
    </div>
    <div>
      <p class="foot-label">Plan</p>
      <ul>
        <li><a href="/scenariusze/">Scenariusze</a></li>
        <li><a href="/jedzenie-i-bar/">Jedzenie i bar</a></li>
        <li><a href="/poradnik/">Poradnik</a></li>
        <li><a href="/warto-wiedziec/">Warto wiedzieć</a></li>
      </ul>
    </div>
    <div>
      <p class="foot-label">Kontakt</p>
      <ul>
        <li><a href="/kontakt/">Napisz do nas</a></li>
        <li><a href="/mapa-strony/">Mapa strony</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap foot-note">
    <p>MIEJSCE · eventy nad wodą · Port Czerniakowski · miejsce.to</p>
  </div>
</footer>
