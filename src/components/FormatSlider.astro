---
import Icon from "./Icon.astro";

const { slides = [] } = Astro.props;
const hrefFor = (slide) => {
  const query = new URLSearchParams();
  if (slide.rodzaj) query.set("rodzaj", slide.rodzaj);
  query.set("wiadomosc", `Chcę zapytać o format: ${slide.tytul}`);
  return `/kontakt/?${query}#brief`;
};
---

<section class="event-format event-tint reveal" id="co-mozna" data-format>
  <div class="wrap">
    <header class="event-head">
      <p class="eyebrow">Zakres</p>
      <h2>Co można tu ułożyć</h2>
    </header>
    <div class="format-row">
      {slides.map((slide, index) => (
        <article class:list={["format-panel", index === 0 && "is-open"]} data-format-panel>
          <button
            type="button"
            class="format-panel-tab"
            aria-expanded={index === 0 ? "true" : "false"}
            aria-controls={`format-body-${index}`}
            id={`format-tab-${index}`}
          >
            <img src={slide.zdjecie} alt="" width="800" height="1000" />
            <span>{slide.tytul}</span>
          </button>
          <div class="format-panel-body" id={`format-body-${index}`}>
            <div class="format-photo">
              <img src={slide.zdjecie} alt="" width="1600" height="1100" />
            </div>
            <div class="format-copy">
              <h3>{slide.tytul}</h3>
              <p>{slide.opis}</p>
              <ul class="format-facts">
                {slide.fakty.map((fact) => (
                  <li><Icon name={fact.ikona} /><span>{fact.tekst}</span></li>
                ))}
              </ul>
              <a class="btn btn-primary" href={hrefFor(slide)}>Zapytaj o ten format</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll("[data-format]").forEach((root) => {
    const panels = [...root.querySelectorAll("[data-format-panel]")];
    if (!panels.length) return;
    let index = Math.max(0, panels.findIndex((panel) => panel.classList.contains("is-open")));

    const open = (next, moveFocus = false) => {
      index = Math.max(0, Math.min(panels.length - 1, next));
      panels.forEach((panel, i) => {
        const on = i === index;
        panel.classList.toggle("is-open", on);
        panel.querySelector(".format-panel-tab")?.setAttribute("aria-expanded", on ? "true" : "false");
      });
      if (!moveFocus) return;
      const tab = panels[index].querySelector(".format-panel-tab");
      const cta = panels[index].querySelector(".btn");
      if (tab instanceof HTMLElement && tab.offsetParent) tab.focus();
      else if (cta instanceof HTMLElement) cta.focus();
    };

    panels.forEach((panel, i) => {
      const tab = panel.querySelector(".format-panel-tab");
      tab?.addEventListener("click", () => open(i));
      if (fine) panel.addEventListener("mouseenter", () => open(i));
    });

    root.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowRight" && event.key !== "ArrowLeft" && event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
      const forward = event.key === "ArrowRight" || event.key === "ArrowDown";
      event.preventDefault();
      open(index + (forward ? 1 : -1), true);
    });

    if (reduce) root.classList.add("is-instant");
  });
</script>
