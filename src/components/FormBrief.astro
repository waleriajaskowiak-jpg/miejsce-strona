---
import { etykiety } from "../lib/copy.js";

const { typy = [], cel = "zapytanie", przestrzen = "", endpoint = "", netlify = true } = Astro.props;
const f = etykiety.formularz;
const wizyta = cel === "ogledziny";
const action = endpoint || "/dziekujemy/";
const useNetlify = !endpoint && netlify;
---

<form
  id="brief"
  name="brief"
  method="POST"
  action={action}
  data-netlify={useNetlify ? "true" : undefined}
  netlify-honeypot="bot-field"
  class="form-grid"
  data-h-ogledziny={f.h_ogledziny}
  data-lead-ogledziny={f.lead_ogledziny}
  data-placeholder-wizyta={f.placeholder_wizyta_msg}
>
  <input type="hidden" name="form-name" value="brief" />
  <p class="hp">
    <label>{f.honeypot} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>
  <label class="field" for="imie">
    <span id="imie-label">{f.imie}</span>
    <input id="imie" name="imie" type="text" autocomplete="given-name" required />
  </label>
  <label class="field" for="email">
    <span>{f.email}</span>
    <input id="email" name="email" type="email" autocomplete="email" required />
  </label>
  <label class="field" for="telefon">
    <span>{f.telefon}</span>
    <input id="telefon" name="telefon" type="tel" autocomplete="tel" inputmode="tel" />
  </label>
  <label class="field" for="data">
    <span>{f.termin}</span>
    <input id="data" name="data" type="text" autocomplete="off" placeholder={wizyta ? f.placeholder_wizyta : f.placeholder_termin_pelny} />
  </label>
  <label class="field" for="osoby">
    <span>{f.osoby}</span>
    <input id="osoby" name="osoby" type="number" inputmode="numeric" min="1" />
  </label>
  <details class="brief-more">
    <summary>{f.doprecyzuj}</summary>
  <label class="field" for="rodzaj">
    <span>{f.rodzaj}</span>
    <select id="rodzaj" name="rodzaj">
      <option value="">{f.wybierz}</option>
      {typy.map((typ) => <option value={typ.id}>{typ.nazwa}</option>)}
    </select>
  </label>
  <label class="field" for="budzet">
    <span>{f.budzet}</span>
    <input id="budzet" name="budzet" type="text" inputmode="numeric" placeholder={f.placeholder_budzet} />
  </label>
  <label class="field" for="jednostka">
    <span>{f.netto_brutto}</span>
    <select id="jednostka" name="jednostka">
      <option value="netto">{f.netto}</option>
      <option value="brutto">{f.brutto}</option>
    </select>
  </label>
  {przestrzen && <p class="meta">{f.pytasz} {przestrzen}</p>}
  <label class="field" for="wiadomosc">
    <span>{f.wiadomosc}</span>
    <textarea id="wiadomosc" name="wiadomosc" placeholder={wizyta ? f.placeholder_wizyta_msg : f.placeholder_wiadomosc}></textarea>
  </label>
  <input type="hidden" name="cel" value={cel} />
  <input type="hidden" name="wynik" value="" />
  <input type="hidden" name="przestrzen" value={przestrzen} />
  </details>
  <button class="btn" type="submit" data-wizyta={f.umow} data-wyslij={f.wyslij}>{wizyta ? f.umow : f.wyslij}</button>
  <p class="fine">{f.stopka}</p>
</form>

<script>
  const form = document.querySelector("#brief");
  if (form instanceof HTMLFormElement) {
    const params = new URLSearchParams(window.location.search);
    if (params.get("cel") === "ogledziny") {
      const h1 = document.querySelector("h1");
      const lede = document.querySelector(".lede");
      if (h1) h1.textContent = form.dataset.hOgledziny || h1.textContent;
      if (lede) lede.textContent = form.dataset.leadOgledziny || lede.textContent;
      const cel = form.elements.namedItem("cel");
      if (cel && "value" in cel) cel.value = "ogledziny";
      const submit = form.querySelector('button[type="submit"]');
      if (submit) submit.textContent = submit.getAttribute("data-wizyta");
      const note = form.querySelector("#wiadomosc");
      if (note instanceof HTMLTextAreaElement) note.placeholder = form.dataset.placeholderWizyta || note.placeholder;
    }
    const map = ["rodzaj", "typ", "data", "osoby", "budzet", "wynik", "przestrzen", "wiadomosc", "jednostka", "imie", "email"];
    const aliases = { typ: "rodzaj", kind: "rodzaj", guests: "osoby", budget: "budzet", unit: "jednostka", date: "data" };
    for (const [key, raw] of params.entries()) {
      const name = aliases[key] || key;
      const value = name === "rodzaj" && raw === "premiery-i-wydarzenia-specjalne" ? "premiery-i-eventy-marek" : raw;
      if (!map.includes(name) && !map.includes(key)) continue;
      const field = form.elements.namedItem(name);
      if (!value || !field || !("value" in field)) continue;
      if (field instanceof HTMLInputElement && field.type === "hidden" && field.value) continue;
      field.value = value;
    }
    if (params.has("rodzaj") || params.has("typ") || params.has("budzet") || params.has("budget") || params.has("cel")) {
      form.querySelector("details")?.setAttribute("open", "");
      form.scrollIntoView({ block: "start" });
    }
  }
</script>
