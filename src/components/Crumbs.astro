---
const { items = [] } = Astro.props;
---

<nav class="crumbs" aria-label="Okruszki">
  <ol>
    <li><a href="/">MIEJSCE</a></li>
    {
      items.map((item, index) => (
        <li>
          {item.href && index < items.length - 1 ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
