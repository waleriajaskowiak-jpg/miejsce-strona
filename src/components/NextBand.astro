---
import { etykiety, nawigacja } from "../lib/copy.js";

const { kicker = etykiety.nastepny_krok, title, lead = "", links = [], cta = nawigacja.cta_mobile, href = "/kontakt/" } = Astro.props;
---

<section class="next-band">
  <div class="wrap next-grid">
    <div class="next-copy">
      <p class="kicker">{kicker}</p>
      <h2>{title}</h2>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <div class="next-actions">
      <div class="btn-row">
        <a class="btn btn-primary" href={href}>{cta}</a>
        {links[0] && <a class="btn btn-ghost" href={links[0].href}>{links[0].label}</a>}
      </div>
    </div>
  </div>
</section>
