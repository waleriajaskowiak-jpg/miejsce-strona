---
const { kicker = "Następny krok", title, links = [], cta = "Zaplanuj event", href = "/kontakt/" } = Astro.props;
---

<section class="next-band">
  <div class="wrap next-grid">
    <div class="next-copy">
      <p class="kicker">{kicker}</p>
      <h2>{title}</h2>
    </div>
    <div class="next-actions">
      <div class="btn-row">
        <a class="btn btn-primary" href={href}>{cta}</a>
        {links[0] && <a class="btn btn-ghost" href={links[0].href}>{links[0].label}</a>}
      </div>
    </div>
  </div>
</section>
