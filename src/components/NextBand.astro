---
const { kicker = "Dalej", title, links = [], cta, href = "/kontakt/" } = Astro.props;
---

<section class="next-band">
  <div class="wrap next-grid">
    <div class="next-copy">
      <p class="kicker">{kicker}</p>
      <h2>{title}</h2>
    </div>
    <div class="next-actions">
      <ul class="next-links">
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <a class="btn btn-primary" href={href}>{cta}</a>
    </div>
  </div>
</section>
