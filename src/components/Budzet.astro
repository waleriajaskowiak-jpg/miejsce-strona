---
import { getCollection } from "astro:content";
import { etykiety } from "../lib/copy.js";

const { cennik, wariant = "pelny" } = Astro.props;
const est = etykiety.estymator;
const toneById = Object.fromEntries((await getCollection("kategorie")).map((item) => [item.id, item.data]));
const neutralTone = { kolor: "#F4EDE3", kolor_tekst: "#2B2B2B" };
const safe = JSON.stringify(cennik).replace(/</g, "\\u003c");
const photos = Object.fromEntries(est.zdjecia.map((item) => [item.id, item.zdjecie]));
const dayShort = Object.fromEntries(est.dni_skrot.map((item) => [item.id, item.skrot]));
const steps = est.kroki.map((step) => ({ n: step.numer, label: step.etykieta, hint: step.podpowiedz }));
---

<section
  class="engine"
  id="budzet"
  data-budzet
  data-wariant={wariant}
  data-dalej={est.dalej}
  data-zobacz={est.zobacz_wynik}
  data-blad-rodzaj={est.blad_rodzaj}
  data-blad-termin={est.blad_termin}
  data-wycena={est.wycena}
  data-odpowiedz={est.odpowiedz}
  data-osob={est.osob}
  data-zl={est.zl}
  data-brief-tytul={est.brief_tytul}
  data-brief-rodzaj={est.brief_rodzaj}
  data-brief-termin={est.brief_termin}
  data-brief-osoby={est.brief_osoby}
  data-brief-budzet={est.brief_budzet}
  data-brief-wynik={est.brief_wynik}
  data-brief-przestrzen={est.brief_przestrzen}
>
  <script type="application/json" class="budzet-config" set:html={safe} />
  <header class="sec-head">
    <div>
      <p class="eyebrow">{est.krok_po_kroku}</p>
      <h2>{cennik.budzet_h}</h2>
    </div>
    <p class="lead">{est.lead}</p>
  </header>

  <ol class="progress-steps" aria-label={est.aria_kroki}>
    {
      steps.map((step, index) => (
        <li data-progress={index} data-podpowiedz={step.hint} class={index === 0 ? "is-current" : undefined}>
          <b>{step.n}</b>
          <span>{step.label}</span>
        </li>
      ))
    }
  </ol>
  <p class="step-hint" data-hint>{steps[0].hint}</p>

  <form class="budzet-form">
    <div class="step-panel" data-step="0">
      <div class="type-grid" role="group" aria-label={est.aria_rodzaj}>
        {
          cennik.typy_eventu.map((typ) => {
            const tone = toneById[typ.kategoria] || neutralTone;
            return (
            <button type="button" class="type-tile" data-group="typ" data-value={typ.id} aria-pressed="false" style={`--event-color:${tone.kolor};--event-on:${tone.kolor_tekst}`}>
              <span class="type-photo">
                {photos[typ.id] && <img src={photos[typ.id]} alt="" width="640" height="480" />}
              </span>
              <span class="type-name"><i class="event-dot" aria-hidden="true"></i>{typ.nazwa}</span>
            </button>
            );
          })
        }
      </div>
      <input type="hidden" name="typ" value="" />
    </div>

    <div class="step-panel" data-step="1" hidden>
      <label class="slider-block">
        <span class="slider-k">{est.liczba_gosci}</span>
        <span class="slider-val" data-osoby-val>80<small>{est.osob}</small></span>
        <input type="range" name="osoby" min="10" max="350" step="5" value="80" />
      </label>
    </div>

    <div class="step-panel" data-step="2" hidden>
      <fieldset class="chip-block">
        <legend>{est.dzien}</legend>
        <div class="chips">
          {
            cennik.dni.map((dzien) => (
              <button type="button" class="chip" data-group="dzien" data-value={dzien.id} aria-pressed="false">
                {dayShort[dzien.id] || dzien.nazwa}
              </button>
            ))
          }
        </div>
      </fieldset>
      <input type="hidden" name="dzien" value="" />
      <fieldset class="chip-block">
        <legend>{est.miesiac}</legend>
        <div class="chips">
          {
            cennik.miesiace.map((miesiac) => (
              <button type="button" class="chip" data-group="miesiac" data-value={String(miesiac.id)} aria-pressed="false">
                {miesiac.nazwa}
              </button>
            ))
          }
        </div>
      </fieldset>
      <input type="hidden" name="miesiac" value="" />
    </div>

    <div class="step-panel" data-step="3" hidden>
      <label class="slider-block">
        <span class="slider-k">{est.budzet_netto}</span>
        <span class="slider-val" data-budzet-val>40&nbsp;000<small>&nbsp;{est.zl}</small></span>
        <input type="range" name="budzet" min="5000" max="250000" step="1000" value="40000" />
      </label>
    </div>

    <div class="step-panel" data-step="4" hidden>
      <article class="result-card" data-wynik aria-live="polite">
        <p class="wynik-kod" data-kod-label>{est.wynik}</p>
        <h3 data-tytul>{est.uzupelnij}</h3>
        <p data-tresc></p>
        <a class="btn btn-primary" data-cta href="/kontakt/#brief">{est.cta}</a>
      </article>
    </div>

    <p class="err" data-err hidden></p>
    <div class="step-nav">
      <button class="btn btn-ghost" type="button" data-back hidden>{est.wstecz}</button>
      <button class="btn btn-primary" type="button" data-next>{est.dalej}</button>
    </div>
  </form>

  <p class="fine">{est.dopisek}</p>
</section>

<script>
  import { ocen } from "../lib/budzet.js";
  import { plNumber, zloty } from "../lib/nav.js";

  document.querySelectorAll("[data-budzet]").forEach((root) => {
    const hints = [...root.querySelectorAll("[data-podpowiedz]")].map((node) => node.getAttribute("data-podpowiedz"));
    const cennik = JSON.parse(root.querySelector(".budzet-config")?.textContent || "{}");
    const form = root.querySelector(".budzet-form");
    const err = root.querySelector("[data-err]");
    const hint = root.querySelector("[data-hint]");
    const back = root.querySelector("[data-back]");
    const next = root.querySelector("[data-next]");
    const panels = [...root.querySelectorAll("[data-step]")];
    const progress = [...root.querySelectorAll("[data-progress]")];
    if (!form || !next) return;
    let step = 0;

    const hidden = (name) => form.querySelector(`input[type="hidden"][name="${name}"]`);
    const label = (list, id) => list?.find((row) => String(row.id) === String(id))?.nazwa || id;

    const show = (index) => {
      step = index;
      panels.forEach((panel) => {
        panel.hidden = Number(panel.getAttribute("data-step")) !== step;
      });
      progress.forEach((item, i) => {
        item.classList.toggle("is-current", i === step);
        item.classList.toggle("is-done", i < step);
      });
      if (hint) hint.textContent = hints[step];
      if (back) back.hidden = step === 0;
      if (next) next.hidden = step === panels.length - 1;
      next.textContent = step === 3 ? root.getAttribute("data-zobacz") : root.getAttribute("data-dalej");
      err.hidden = true;
    };

    const paintRange = (input, output, suffix) => {
      if (!input || !output) return;
      const formatted = suffix === root.getAttribute("data-zl") ? plNumber(Number(input.value)) : input.value;
      output.firstChild.textContent = formatted;
    };

    const osoby = form.querySelector('input[name="osoby"]');
    const budzet = form.querySelector('input[name="budzet"]');
    osoby?.addEventListener("input", () => paintRange(osoby, root.querySelector("[data-osoby-val]"), root.getAttribute("data-osob")));
    budzet?.addEventListener("input", () => paintRange(budzet, root.querySelector("[data-budzet-val]"), root.getAttribute("data-zl")));

    root.querySelectorAll("[data-group]").forEach((button) => {
      button.addEventListener("click", () => {
        const group = button.getAttribute("data-group");
        const value = button.getAttribute("data-value") || "";
        root.querySelectorAll(`[data-group="${group}"]`).forEach((peer) => {
          peer.setAttribute("aria-pressed", peer === button ? "true" : "false");
        });
        const field = hidden(group);
        if (field) field.value = value;
      });
    });

    const params = new URLSearchParams(location.search);
    const presetTyp = params.get("typ");
    if (presetTyp) root.querySelector(`[data-group="typ"][data-value="${presetTyp}"]`)?.dispatchEvent(new Event("click"));
    const presetBudzet = params.get("budzet") || params.get("budget");
    if (presetBudzet && budzet) {
      const n = Number(String(presetBudzet).replace(/[^\d]/g, ""));
      if (Number.isFinite(n)) {
        budzet.value = String(Math.min(250000, Math.max(5000, n)));
        paintRange(budzet, root.querySelector("[data-budzet-val]"), root.getAttribute("data-zl"));
      }
    }
    const presetOsoby = params.get("osoby") || params.get("guests");
    if (presetOsoby && osoby) {
      const n = Number(String(presetOsoby).replace(/[^\d]/g, ""));
      if (Number.isFinite(n)) {
        osoby.value = String(Math.min(350, Math.max(10, n)));
        paintRange(osoby, root.querySelector("[data-osoby-val]"), root.getAttribute("data-osob"));
      }
    }

    const finish = () => {
      const data = new FormData(form);
      const input = {
        typ: String(data.get("typ") || ""), osoby: String(data.get("osoby") || ""), budzet: String(data.get("budzet") || ""), dzien: String(data.get("dzien") || ""), miesiac: String(data.get("miesiac") || ""), };
      const result = ocen(input, cennik);
      const title = root.querySelector("[data-tytul]");
      const text = root.querySelector("[data-tresc]");
      const code = root.querySelector("[data-kod-label]");
      const cta = root.querySelector("[data-cta]");
      if (!result.ok) {
        err.hidden = false;
        err.textContent = result.error;
        return false;
      }
      if (code) code.textContent = result.indywidualna ? root.getAttribute("data-wycena") : `${root.getAttribute("data-odpowiedz")} ${result.kod}`;
      if (title) title.textContent = result.tytul;
      if (text) text.textContent = result.tresc;
      const dzien = label(cennik.dni, input.dzien);
      const miesiac = label(cennik.miesiace, input.miesiac);
      const rodzaj = label(cennik.typy_eventu, input.typ);
      const osobyN = input.osoby.replace(/[^\d]/g, "");
      const budzetN = input.budzet.replace(/[^\d]/g, "");
      const query = new URLSearchParams();
      query.set("rodzaj", input.typ);
      query.set("data", `${dzien} / ${miesiac}`);
      query.set("osoby", osobyN);
      query.set("budzet", budzetN);
      query.set("wynik", result.kod);
      query.set("przestrzen", result.przestrzen);
      query.set(
        "wiadomosc", [
          root.getAttribute("data-brief-tytul"), `${root.getAttribute("data-brief-rodzaj")}: ${rodzaj}`, `${root.getAttribute("data-brief-termin")}: ${dzien} / ${miesiac}`, `${root.getAttribute("data-brief-osoby")}: ${osobyN}`, `${root.getAttribute("data-brief-budzet")}: ${zloty(Number(budzetN))}`, `${root.getAttribute("data-brief-wynik")}: ${result.kod} — ${result.tytul}`, `${root.getAttribute("data-brief-przestrzen")}: ${result.przestrzen}`, ].join("\n"), );
      cta?.setAttribute("href", `/kontakt/?${query.toString()}#brief`);
      return true;
    };

    const validate = () => {
      if (step === 0 && !hidden("typ")?.value) return root.getAttribute("data-blad-rodzaj");
      if (step === 2 && (!hidden("dzien")?.value || !hidden("miesiac")?.value)) return root.getAttribute("data-blad-termin");
      return "";
    };

    next.addEventListener("click", () => {
      const problem = validate();
      if (problem) {
        err.hidden = false;
        err.textContent = problem;
        return;
      }
      if (step === 3 && !finish()) return;
      show(Math.min(panels.length - 1, step + 1));
    });
    back?.addEventListener("click", () => show(Math.max(0, step - 1)));
    show(0);
  });
</script>
